---
import originalLogo from '../assets/images/originals/logo-footer-transparent.png';

interface Props {
  variant?: 'header' | 'footer';
}

const { variant = 'header' } = Astro.props;
---

<span class:list={['original-wordmark', `original-wordmark--${variant}`]} aria-hidden="true">
  <svg class="wordmark-artwork" viewBox="35 115 1395 570" role="presentation" focusable="false">
    <!-- Original artwork: K, lettering, domain, emblem and divider line. -->
    <image href={originalLogo.src} x="0" y="0" width="1477" height="1065" />
  </svg>
</span>

<style>
  .original-wordmark { display: inline-flex; flex: 0 0 auto; color: var(--color-ink); }
  .wordmark-artwork { display: block; width: var(--wordmark-width); height: auto; overflow: hidden; }
  .original-wordmark--header { --wordmark-width: 13rem; }
  .original-wordmark--footer { --wordmark-width: min(18rem, 78vw); }
  @media (max-width: 59.99rem) {
    .original-wordmark--header { --wordmark-width: 11rem; }
  }
  @media (max-width: 24rem) {
    .original-wordmark--header { --wordmark-width: 9.5rem; }
  }
</style>
