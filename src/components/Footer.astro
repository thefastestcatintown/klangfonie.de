---
import type { SiteSettings } from '../lib/types';
import { languageFromPath, localizePath } from '../lib/i18n';
import { navigationFor } from '../lib/navigation';
import { getPageCopy } from '../lib/sanity';
import { defaultsFor } from '../content/page-copy-defaults';
import BrandWordmark from './BrandWordmark.astro';
interface Props { settings: SiteSettings; }
const { settings } = Astro.props;
const language = languageFromPath(Astro.url.pathname);
const copy = await getPageCopy('global', language, defaultsFor('global', language));
const labels: Record<string, string> = {
  '/unterricht': copy.coachingLabel, '/yoga': copy.navRetreats, '/live': copy.navMusic,
  '/ueber-daniela/intention': copy.navAbout, '/termine': copy.navEvents, '/kontakt': copy.navContact,
};
const footerLinks = navigationFor(language).footerLinks.map((item) => ({ ...item, label: labels[item.href] || item.label }));
const year = new Date().getFullYear();
const hasContact = Boolean(settings.phone);
const footerColumns = 1 + Number(hasContact);
const socials = [
  { label: 'Instagram', url: settings.instagram },
  { label: 'YouTube', url: settings.youtube },
].filter((social): social is { label: string; url: string } => Boolean(social.url));
---
<footer class="footer">
  <div class="container footer-grid" style={`--footer-columns: ${footerColumns}`}>
    <div>
      <a class="footer-brand" href={localizePath('/', language)} aria-label={copy.homeLabel}>
        <BrandWordmark variant="footer" showDomain />
        <span class="footer-brand-copy">
          <span class="footer-tagline">{copy.footerTagline}</span>
          <span class="footer-name">Daniela Schneider</span>
        </span>
      </a>
      <a class="footer-newsletter" href={localizePath(`/kontakt#${language === 'en' ? 'mailing-list' : 'verteiler'}`, language)}>
        <span>{copy.footerNewsletter}</span><span aria-hidden="true">↗</span>
      </a>
    </div>
    {hasContact && <div class="footer-contact">
      {settings.phone && <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a>}
    </div>}
    <div>
      {footerLinks.map((item) => <a href={localizePath(item.href, language)}>{item.label}</a>)}
    </div>
  </div>
  <div class:list={['container', 'footer-bottom', { 'footer-bottom--without-socials': socials.length === 0 }]}>
    {socials.length > 0 && <div class="footer-socials" role="group" aria-label="Social Media">
      {socials.map((social) => (
          <a class="social-icon" href={social.url} target="_blank" rel="noreferrer" aria-label={social.label} title={social.label}>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              {social.label === 'Instagram' ? (
                <>
                  <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7" />
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
                </>
              ) : (
                <>
                  <path d="M21.5 7.1a2.8 2.8 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.5.4a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.1 12a29 29 0 0 0 .4 4.9 2.8 2.8 0 0 0 2 2c1.7.4 7.5.4 7.5.4s5.8 0 7.5-.4a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .4-4.9 29 29 0 0 0-.4-4.9Z" stroke="currentColor" stroke-width="1.7" />
                  <path d="m10 8.5 6 3.5-6 3.5Z" fill="currentColor" />
                </>
              )}
            </svg>
          </a>
      ))}
    </div>}
    <span>© {year} Klangfonia</span>
    <div class="footer-legal"><a href={localizePath('/impressum', language)}>{copy.legalLabel}</a><a href={localizePath('/datenschutz', language)}>{copy.privacyLabel}</a></div>
  </div>
</footer>

<style>
  .footer { padding: clamp(2.5rem, 5vw, 4rem) 0 1.5rem; border-top: 1px solid var(--color-border); background: linear-gradient(135deg, #cbd4c2, var(--color-footer)); color: var(--color-ink); }
  .footer-grid { display: grid; gap: 2.5rem; }
  .footer-grid > div { display: flex; align-items: flex-start; flex-direction: column; min-width: 0; }
  .footer a { padding-block: 0.2rem; overflow-wrap: anywhere; color: inherit; text-decoration: none; }
  .footer a:hover { color: var(--color-clay-dark); text-decoration: underline; text-underline-offset: 0.25em; }
  .footer-brand { max-width: 100%; display: inline-flex; align-items: flex-start; flex-direction: column; gap: 0.25rem; margin-bottom: 0.5rem; color: var(--color-ink) !important; text-decoration: none !important; }
  .footer-brand-copy { display: flex; align-items: flex-start; flex-direction: column; padding-left: 5rem; line-height: 1.2; }
  .footer-tagline { color: var(--color-ink); font-family: var(--font-display); font-size: 0.88rem; font-weight: 400; letter-spacing: -0.015em; }
  .footer-name { margin-top: 0.2rem; color: var(--color-clay-dark); font-size: 0.68rem; font-weight: 700; }
  .footer-newsletter { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 0.65rem; margin-top: 1.1rem; padding: 0.65rem 1rem !important; border: 1px solid rgb(38 53 47 / 0.28); border-radius: 99rem; color: var(--color-ink); font-size: 0.8rem; font-weight: 700; text-decoration: none !important; transition: border-color 180ms ease, background 180ms ease, color 180ms ease, transform 180ms ease; }
  .footer-newsletter:hover { border-color: var(--color-clay-dark); background: rgb(252 250 245 / 0.5); color: var(--color-clay-dark) !important; text-decoration: none !important; transform: translateY(-2px); }
  .footer-newsletter:focus-visible { outline: 2px solid var(--color-clay-dark); outline-offset: 3px; }

  .footer-socials { display: flex; align-items: center; justify-content: flex-start; gap: 0.75rem; padding: 0; border: 0; background: transparent; }
  .social-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; color: var(--color-ink); }
  .footer-bottom { display: grid; grid-template-columns: 1fr auto 1fr; margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid rgb(38 53 47 / 0.2); align-items: center; justify-content: space-between; gap: 1rem; font-size: 0.8rem; }
  .footer-bottom--without-socials { grid-template-columns: 1fr auto; }
  .footer-legal { display: flex; justify-content: flex-end; gap: 1.25rem; }
  .footer-contact { gap: 0.5rem; }
  @media (min-width: 60rem) {
    .footer-grid { grid-template-columns: minmax(0, 1.6fr) repeat(var(--footer-columns), minmax(0, 1fr)); }
  }
  @media (min-width: 60rem) and (max-height: 56rem) {
    .footer { padding-block: 2.5rem 1.25rem; }
    .footer-bottom { margin-top: 1.75rem; }
  }
  @media (max-width: 32rem) { .footer-bottom { grid-template-columns: auto 1fr; } .footer-legal { grid-column: 1 / -1; justify-content: flex-start; } }
</style>
