---
import type { SiteSettings } from '../lib/types';
import { withBase } from '../lib/urls';
interface Props { settings: SiteSettings; }
const { settings } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href={withBase('/')}>Klangfonie</a>
      <p>Handpan · Musik · Begegnung</p>
    </div>
    <div>
      <p class="footer-label">Kontakt</p>
      {settings.email ? <a href={`mailto:${settings.email}`}>{settings.email}</a> : <span>[E-Mail im CMS ergänzen]</span>}
      {settings.phone && <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a>}
    </div>
    <div>
      <p class="footer-label">Entdecken</p>
      <a href={withBase('/unterricht')}>Unterricht</a><a href={withBase('/yoga')}>Yoga</a><a href={withBase('/live')}>Live</a>
    </div>
    <div>
      <p class="footer-label">Folgen</p>
      {settings.instagram ? <a href={settings.instagram} target="_blank" rel="noreferrer">Instagram</a> : <span>Instagram folgt</span>}
      {settings.youtube ? <a href={settings.youtube} target="_blank" rel="noreferrer">YouTube</a> : <span>YouTube folgt</span>}
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Klangfonie</span>
    <div><a href={withBase('/impressum')}>Impressum</a><a href={withBase('/datenschutz')}>Datenschutz</a></div>
  </div>
</footer>
<style>
  .footer { padding: 4.5rem 0 1.5rem; background: var(--color-charcoal); color: rgb(255 254 251 / 0.72); }
  .footer-grid { display: grid; gap: 2.5rem; }
  .footer-grid > div { display: flex; align-items: flex-start; flex-direction: column; }
  .footer a { color: inherit; text-decoration: none; }
  .footer a:hover { color: white; }
  .footer-brand { margin-bottom: 0.4rem; color: white !important; font-family: var(--font-display); font-size: 2rem; }
  .footer-label { margin-bottom: 0.75rem; color: white; font-size: 0.72rem; font-weight: 750; letter-spacing: 0.14em; text-transform: uppercase; }
  .footer-bottom { display: flex; margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.12); align-items: center; justify-content: space-between; gap: 1rem; font-size: 0.8rem; }
  .footer-bottom div { display: flex; gap: 1.25rem; }
  @media (min-width: 40rem) { .footer-grid { grid-template-columns: 2fr repeat(3, 1fr); } }
  @media (max-width: 32rem) { .footer-bottom { align-items: flex-start; flex-direction: column; } }
</style>
