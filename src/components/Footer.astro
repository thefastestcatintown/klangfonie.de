---
import { Image } from 'astro:assets';
import handpanLogo from '../assets/images/klangfonia-handpan-logo.png';
import type { SiteSettings } from '../lib/types';
import { withBase } from '../lib/urls';
interface Props { settings: SiteSettings; }
const { settings } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class:list={['container', 'footer-grid', { 'footer-grid--with-socials': settings.instagram || settings.youtube }] }>
    <div>
      <a class="footer-brand" href={withBase('/')} aria-label="Klangfonia – Startseite">
        <Image class="footer-logo" src={handpanLogo} alt="" width={104} height={104} aria-hidden="true" />
        <span class="footer-name" aria-hidden="true"><span class="footer-initial">K</span><span>langfonia</span></span>
      </a>
      <p>Handpan · Musik · Begegnung</p>
    </div>
    <div>
      <p class="footer-label">Kontakt</p>
      {settings.email ? <a href={`mailto:${settings.email}`}>{settings.email}</a> : <a href={withBase('/kontakt')}>Kontakt aufnehmen</a>}
      {settings.phone && <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a>}
    </div>
    <div>
      <p class="footer-label">Entdecken</p>
      <a href={withBase('/unterricht')}>Lernbegleitung</a><a href={withBase('/yoga')}>Yoga</a><a href={withBase('/live')}>Live</a>
    </div>
    {(settings.instagram || settings.youtube) && (
      <div>
        <p class="footer-label">Folgen</p>
        {settings.instagram && <a href={settings.instagram} target="_blank" rel="noreferrer">Instagram</a>}
        {settings.youtube && <a href={settings.youtube} target="_blank" rel="noreferrer">YouTube</a>}
      </div>
    )}
  </div>
  <div class="container footer-bottom">
    <span>© {year} Klangfonia</span>
    <div><a href={withBase('/impressum')}>Impressum</a><a href={withBase('/datenschutz')}>Datenschutz</a></div>
  </div>
</footer>
<style>
  .footer { padding: 5rem 0 1.5rem; background: var(--color-charcoal); color: rgb(255 253 247 / 0.7); }
  .footer-grid { display: grid; gap: 2.5rem; }
  .footer-grid > div { display: flex; align-items: flex-start; flex-direction: column; }
  .footer a { color: inherit; text-decoration: none; }
  .footer a:hover { color: white; }
  .footer-brand { display: inline-flex; align-items: center; gap: 0.65rem; margin-bottom: 0.5rem; color: white !important; font-family: var(--font-display); font-size: 2rem; letter-spacing: -0.035em; }
  .footer-logo { width: 5.25rem; height: 5.25rem; object-fit: contain; }
  .footer-name { display: inline-flex; align-items: baseline; }
  .footer-initial { margin-right: 0.03em; color: var(--color-sand); font-family: var(--font-accent); font-size: 2.15em; line-height: 0; }
  .footer-label { margin-bottom: 0.75rem; color: white; font-size: 0.72rem; font-weight: 750; letter-spacing: 0.14em; text-transform: uppercase; }
  .footer-bottom { display: flex; margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.12); align-items: center; justify-content: space-between; gap: 1rem; font-size: 0.8rem; }
  .footer-bottom div { display: flex; gap: 1.25rem; }
  @media (min-width: 40rem) {
    .footer-grid { grid-template-columns: 2fr repeat(2, 1fr); }
    .footer-grid--with-socials { grid-template-columns: 2fr repeat(3, 1fr); }
  }
  @media (max-width: 32rem) { .footer-bottom { align-items: flex-start; flex-direction: column; } }
</style>
