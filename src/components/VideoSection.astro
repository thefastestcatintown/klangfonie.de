---
import type { Video } from '../lib/types';
import { youtubeEmbedUrl } from '../lib/youtube';
interface Props { video: Video | null; headline: string; text: string; }
const { video, headline, text } = Astro.props;
const embedUrl = youtubeEmbedUrl(video?.youtubeUrl);
---
<section class="section video-section" id="musik">
  <div class="container">
    <div class="video-intro">
      <h2>{headline}</h2><p class="lead">{text}</p>
    </div>
    <div class="video-frame">
      {embedUrl ? (
        <iframe src={embedUrl} title={video?.title || 'Klangfonia Video'} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      ) : (
        <div class="video-placeholder">
          <span class="play" aria-hidden="true">▶</span>
          <div><strong>Hier klingt bald Klangfonia.</strong><small>Video lässt sich im Sanity Studio hinterlegen.</small></div>
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .video-section { border-block: 1px solid var(--color-border); background: radial-gradient(ellipse at 100% 0%, rgb(185 157 117 / 0.12), transparent 60%), linear-gradient(135deg, var(--color-white), var(--color-linen)); color: var(--color-ink); }
  .video-intro { max-width: 47rem; }
  .video-intro::before { content: ''; display: block; width: 3rem; height: 1px; margin-bottom: 1.25rem; background: var(--color-clay); }
  h2 { color: var(--color-ink); }
  .lead { margin-top: 0.75rem; color: var(--color-steel); }
  .video-frame { position: relative; overflow: hidden; width: 100%; max-width: 48rem; aspect-ratio: 16 / 9; margin: 1.5rem auto 0; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-linen); box-shadow: var(--shadow-soft); }
  iframe { position: absolute; inset: 0; display: block; width: 100%; height: 100%; border: 0; }
  .video-placeholder { display: flex; height: 100%; align-items: center; justify-content: center; gap: 1.25rem; padding: 1.5rem; background: radial-gradient(circle at 62% 38%, rgb(252 250 245 / 0.7), transparent 60%), linear-gradient(135deg, var(--color-linen), var(--color-sage-soft)); text-align: left; }
  .video-placeholder::before { content: ''; position: absolute; width: 21rem; height: 21rem; border: 1px solid var(--color-border); border-radius: 50%; }
  .play { display: grid; z-index: 1; width: 4.5rem; height: 4.5rem; flex: 0 0 auto; place-items: center; border-radius: 50%; background: var(--color-clay); color: white; box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.16); }
  .video-placeholder div { z-index: 1; display: flex; flex-direction: column; }.video-placeholder strong { font-family: var(--font-display); font-size: clamp(1.25rem, 3vw, 2rem); font-weight: 400; }.video-placeholder small { opacity: 0.7; }
  @media (min-width: 60rem) {
    .video-section > .container { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: center; gap: 2.5rem; }
    .video-frame { margin: 0; }
  }
</style>
