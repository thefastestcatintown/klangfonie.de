---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from './Button.astro';
import DecorativeHeading from './DecorativeHeading.astro';
import RichText from './RichText.astro';
import type { Service } from '../lib/types';
import { imageUrl } from '../lib/sanity';
import { localizePath, type Language } from '../lib/i18n';

interface Props {
  service: Service;
  title?: string;
  contentHeading?: string;
  intro?: string;
  bullets: string[];
  fallbackBody: string[];
  closingBody?: string[];
  fallbackImage?: ImageMetadata;
  fallbackImageAlt?: string;
  note?: string;
  ctaLabel?: string;
  ctaUrl?: string;
  lang?: Language;
}
const { service, title, contentHeading, intro, bullets, fallbackBody, closingBody = [], fallbackImage, fallbackImageAlt = service.title, note, ctaLabel, ctaUrl, lang = 'de' } = Astro.props;
const image = imageUrl(service.image, 1200);
const pageTitle = title || service.headline;
---
<BaseLayout image={image} lang={lang}>
  <section class="page-hero">
    <div class="container page-hero__inner"><DecorativeHeading level="h1" class="page-title" text={pageTitle} />{intro && <p class="lead">{intro}</p>}</div>
  </section>
  <section class="section">
    <div class="container rich-layout">
      <aside>
        {image ? <div class="feature-image"><img src={image} alt={lang === 'en' ? fallbackImageAlt : (service.image?.alt || service.title)} width="1200" /></div> : fallbackImage ? (
          <div class="feature-image"><Image src={fallbackImage} alt={fallbackImageAlt} width={1200} /></div>
        ) : (
          <div class="image-placeholder"><span>{lang === 'en' ? 'An image can be added in Sanity Studio.' : 'Bild kann im Sanity Studio ergänzt werden.'}</span></div>
        )}
        {(service.duration || service.priceInfo) && <div class="meta-row">{service.duration && <span class="meta-chip">{lang === 'en' ? 'Duration' : 'Dauer'}: {service.duration}</span>}{service.priceInfo && <span class="meta-chip">{service.priceInfo}</span>}</div>}
      </aside>
      <div>
        {contentHeading && <DecorativeHeading level="h2" text={contentHeading} />}
        <RichText value={lang === 'en' ? undefined : service.body} fallback={fallbackBody} />
        <ul class="service-list">{bullets.map((bullet) => <li>{bullet}</li>)}</ul>
        {closingBody.length > 0 && <div class="prose closing-copy">{closingBody.map((paragraph) => <p>{paragraph}</p>)}</div>}
        {note && <p class="highlight">{note}</p>}
        <div class="action"><Button href={localizePath(ctaUrl || service.ctaUrl, lang)}>{ctaLabel || service.ctaLabel}</Button></div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .service-list { display: grid; gap: 0; margin: 2.5rem 0 0; padding: 0; border-top: 1px solid var(--color-sand); list-style: none; }
  :global(h2) + :global(.prose) { margin-top: 1rem; }
  .service-list li { position: relative; padding: 0.85rem 0 0.85rem 1.4rem; border-bottom: 1px solid var(--color-sand); color: var(--color-ink); }
  .service-list li::before { content: '↗'; position: absolute; left: 0; color: var(--color-clay); }
  .closing-copy { margin-top: 2rem; }
  .action { margin-top: 2rem; }
</style>
