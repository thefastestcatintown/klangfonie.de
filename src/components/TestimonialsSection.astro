---
import SectionHeading from './SectionHeading.astro';
import TestimonialCard from './TestimonialCard.astro';
import { getTestimonials } from '../lib/sanity';
import type { Testimonial } from '../lib/types';
import { languageFromPath } from '../lib/i18n';

const testimonials = await getTestimonials();
const language = languageFromPath(Astro.url.pathname);

const examples: Testimonial[] = [
  {
    quote: 'Ich hatte vorher noch nie ein Instrument gespielt. Daniela erklärt ruhig und verständlich, sodass ich schon nach kurzer Zeit eigene Rhythmen ausprobieren konnte.',
    name: 'Beispielstimme',
    sourceType: 'Schüler:in',
    context: 'Lernbegleitung 1:1',
  },
  {
    quote: 'Der Workshop hatte eine sehr angenehme Atmosphäre. Ich konnte ohne Druck entdecken, wie vielseitig die Handpan klingt, und habe viele Ideen zum Weiterüben mitgenommen.',
    name: 'Beispielstimme',
    sourceType: 'Schüler:in',
    context: 'Einsteiger-Workshop',
  },
  {
    quote: 'Daniela verbindet klare Erklärungen mit viel Raum für das eigene musikalische Gefühl. Dadurch hat sich mein Spiel freier und sicherer entwickelt.',
    name: 'Beispielstimme',
    sourceType: 'Schüler:in',
    context: 'Handpan-Unterricht',
  },
];

const englishExamples: Testimonial[] = [
  {
    quote: 'I had never played an instrument before. Daniela explains things calmly and clearly, so after only a short time I felt confident enough to try my own rhythms.',
    name: 'Example testimonial',
    sourceType: 'Schüler:in',
    context: 'One-to-one guidance',
  },
  {
    quote: 'The workshop had a wonderfully relaxed atmosphere. I could explore the many sounds of the handpan without pressure and took home plenty of ideas for my own practice.',
    name: 'Example testimonial',
    sourceType: 'Schüler:in',
    context: 'Beginner workshop',
  },
  {
    quote: 'Daniela combines clear guidance with plenty of space for your own musical intuition. My playing has become freer and more confident as a result.',
    name: 'Example testimonial',
    sourceType: 'Schüler:in',
    context: 'Handpan lessons',
  },
];

const englishTestimonials = testimonials
  .filter((testimonial) => testimonial.quoteEn)
  .map((testimonial) => ({
    ...testimonial,
    quote: testimonial.quoteEn as string,
    name: testimonial.nameEn || testimonial.name,
    context: testimonial.contextEn || testimonial.context,
  }));

const cards = language === 'en'
  ? [
      ...englishTestimonials.map((testimonial) => ({ testimonial, isExample: false })),
      ...englishExamples.map((testimonial) => ({ testimonial, isExample: true })),
    ].slice(0, 3)
  : [
      ...testimonials.map((testimonial) => ({ testimonial, isExample: false })),
      ...examples.map((testimonial) => ({ testimonial, isExample: true })),
    ].slice(0, 3);

const hasExamples = cards.some(({ isExample }) => isExample);
const copy = language === 'en'
  ? {
      title: 'Student voices',
      text: 'Personal experiences from lessons and workshops.',
      note: 'The texts marked “Example” demonstrate the intended presentation and will be replaced with approved original testimonials before the official launch.',
    }
  : {
      title: 'Schülerstimmen',
      text: 'Persönliche Erfahrungen aus Unterricht und Workshops.',
      note: 'Die als „Beispiel“ gekennzeichneten Texte zeigen vorerst die geplante Darstellung und werden vor dem offiziellen Start durch freigegebene Originalstimmen ersetzt.',
    };
---

<section class="section testimonials" aria-labelledby="schuelerstimmen">
  <div class="container">
    <div id="schuelerstimmen">
      <SectionHeading
        title={copy.title}
        text={copy.text}
        align="center"
      />
    </div>

    <div class="testimonials__grid">
      {cards.map(({ testimonial, isExample }) => (
        <TestimonialCard testimonial={testimonial} isExample={isExample} lang={language} />
      ))}
    </div>

    {hasExamples && (
      <p class="testimonials__note">
        {copy.note}
      </p>
    )}
  </div>
</section>

<style>
  .testimonials {
    border-block: 1px solid rgb(38 53 47 / 0.08);
    background:
      radial-gradient(circle at 12% 18%, rgb(142 155 127 / 0.16), transparent 22rem),
      var(--color-linen);
  }
  .testimonials__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.25rem, 5vw, 4rem);
  }
  .testimonials__note {
    max-width: 52rem;
    margin: 1.5rem auto 0;
    color: var(--color-steel);
    font-size: 0.8rem;
    line-height: 1.6;
    text-align: center;
  }
  @media (min-width: 48rem) {
    .testimonials__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 72rem) {
    .testimonials__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 60rem) and (max-height: 56rem) {
    .testimonials__grid { gap: 1rem; margin-top: 2rem; }
    .testimonials__note { margin-top: 1rem; }
  }
</style>
