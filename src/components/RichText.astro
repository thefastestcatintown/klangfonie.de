---
import { PortableText } from 'astro-portabletext';
import type { PortableTextBlock } from '@portabletext/types';
interface Props { value?: PortableTextBlock[]; fallback?: string[]; }
const { value = [], fallback = [] } = Astro.props;
---
<div class="prose">
  {value.length > 0 ? <PortableText value={value} /> : fallback.map((paragraph) => <p>{paragraph}</p>)}
</div>
