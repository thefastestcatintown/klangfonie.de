---
import DecorativeHeading from './DecorativeHeading.astro';

interface Props { title: string; text?: string; align?: 'left' | 'center'; }
const { title, text, align = 'left' } = Astro.props;
---
<header class:list={['heading', `heading--${align}`]}>
  <DecorativeHeading level="h2" text={title} />
  {text && <p class="lead">{text}</p>}
</header>
<style>
  .heading { max-width: 47rem; }
  .heading--center { margin-inline: auto; text-align: center; }
  .lead { margin-top: 1.4rem; }
</style>
