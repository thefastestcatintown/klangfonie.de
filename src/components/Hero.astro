---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/originals/hero-daniela-handpan-2026-11-06.png';
import type { HomePage } from '../lib/types';
import type { Language } from '../lib/i18n';
import DecorativeHeading from './DecorativeHeading.astro';
import { getPageCopy } from '../lib/sanity';
import { defaultsFor } from '../content/page-copy-defaults';

interface Props { content: HomePage; lang?: Language; }
const { content, lang = 'de' } = Astro.props;
const copy = await getPageCopy('global', lang, defaultsFor('global', lang));
const imageAlt = copy.heroImageAlt;
const caption = copy.heroCaption;
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <DecorativeHeading level="h1" text={content.heroHeadline} />
      <p class="lead">{content.heroText}</p>
    </div>
    <figure class="hero-visual reveal">
      <Image src={heroImage} alt={imageAlt} widths={[480, 720, 800, 1200, 1600]} sizes="(min-width: 84rem) 1280px, (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2rem)" quality={72} loading="eager" fetchpriority="high" />
      <figcaption><strong>Daniela Schneider</strong><span>{caption}</span></figcaption>
    </figure>
  </div>
</section>
<style>
  .hero { padding: clamp(1rem, 2vw, 2rem) 0 clamp(2rem, 4vw, 3.5rem); background: var(--color-linen); border-bottom: 1px solid var(--color-border); }
  .hero-grid { display: flex; flex-direction: column; gap: clamp(2rem, 4vw, 3.5rem); }
  .hero-copy { width: 100%; padding-bottom: 1rem; }
  :global(h1) { font-size: clamp(2.5rem, 4.2vw, 3.75rem); max-width: 24ch; text-wrap: balance; }
  .lead { max-width: 42rem; margin-top: 0.75rem; }
  .hero-visual { order: -1; position: relative; width: 100%; margin: 0; }
  .hero-visual :global(img) { width: 100%; height: auto; aspect-ratio: 2 / 1; border: 1px solid rgb(38 53 47 / 0.08); border-radius: var(--radius-lg); object-fit: cover; box-shadow: 0 1.25rem 3.5rem rgb(38 53 47 / 0.1); filter: saturate(0.72) sepia(0.1) hue-rotate(-5deg) brightness(1.015); }
  figcaption { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.4rem 1.25rem; margin: 1rem clamp(0.15rem, 1.4vw, 1rem) 0; padding-left: 1rem; border-left: 1px solid var(--color-clay); color: var(--color-ink); line-height: 1.5; }
  figcaption strong { font-family: var(--font-display); font-size: clamp(1.05rem, 1.6vw, 1.3rem); font-weight: 400; letter-spacing: -0.025em; }
  figcaption span { color: var(--color-steel); font-size: 0.8rem; font-weight: 400; letter-spacing: 0.04em; }
  @media (min-width: 64rem) {
    .hero-copy { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); column-gap: var(--layout-gap); align-items: center; }
    .lead { margin-top: 0; }
  }
  @media (max-width: 40rem) {
    .hero-visual :global(img) { aspect-ratio: 2 / 1; }
    figcaption { align-items: flex-start; flex-direction: column; gap: 0.15rem; margin-top: 0.85rem; }
  }
  @media (min-width: 60rem) and (max-height: 56rem) {
    .hero { padding-block: 1rem 2.25rem; }
    :global(h1) { font-size: clamp(2.5rem, 3.7vw, 3.35rem); }
    .hero-visual :global(img) { aspect-ratio: 2 / 1; }
    figcaption { margin-top: 0.75rem; }
  }
</style>
