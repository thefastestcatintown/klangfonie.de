---
import { Image, getImage } from 'astro:assets';
import profil2 from '../assets/images/originals/profil2.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import DecorativeHeading from './DecorativeHeading.astro';
import { contentPath, localizePath, type Language } from '../lib/i18n';
import { navigationFor } from '../lib/navigation';
import '../styles/coaching.css';
import { getAbout, getPageCopy, imageSrcSet, imageUrl } from '../lib/sanity';
import { defaultsFor } from '../content/page-copy-defaults';
import type { SanityImage } from '../lib/types';

interface Milestone {
  year?: string;
  text: string;
  details?: string[];
}

interface Props {
  title: string;
  paragraphs: string[];
  milestones?: Milestone[];
  lang?: Language;
  portrait?: SanityImage;
}

const { title, paragraphs, milestones = [], lang = 'de', portrait } = Astro.props;
const current = contentPath(Astro.url.pathname);
const { aboutLinks } = navigationFor(lang);
const [fallbackPortrait, globalCopy, about] = await Promise.all([
  getImage({ src: profil2, width: 1200, format: 'webp' }),
  getPageCopy('global', lang, defaultsFor('global', lang)),
  getAbout(),
]);
const selectedPortrait = portrait || about.portrait;
const cmsPortrait = imageUrl(selectedPortrait, 1200, 1600);
const cmsPortraitSrcSet = imageSrcSet(selectedPortrait, [480, 800, 1200], 4 / 3);
const portraitAlt = (lang === 'en' ? selectedPortrait?.altEn || selectedPortrait?.alt : selectedPortrait?.alt) || globalCopy.aboutImageAlt;
---
<BaseLayout image={cmsPortrait || fallbackPortrait.src} lang={lang}>
  <section class="page-hero about-hero">
    <div class="container page-hero__inner">
      <DecorativeHeading level="h1" class="page-title" text={title} />
      <nav class="coaching-tabs" aria-label={lang === 'en' ? 'About Daniela' : 'Über Daniela'}>
        {aboutLinks.map(({ href, label }) => (
          <a href={localizePath(href, lang)} aria-current={current === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </div>
  </section>
  <section class="section">
    <div class="container rich-layout">
      <div class="portrait">
        {cmsPortrait
          ? <img src={cmsPortrait} srcset={cmsPortraitSrcSet} alt={portraitAlt} width="1200" height="1600" sizes="(min-width: 84rem) 505px, (min-width: 48rem) 42vw, calc(100vw - 2rem)" loading="eager" fetchpriority="high" />
          : <Image src={profil2} alt={portraitAlt} width={1200} widths={[480, 800, 1200]} sizes="(min-width: 84rem) 505px, (min-width: 48rem) 42vw, calc(100vw - 2rem)" format="webp" quality={72} />}
      </div>
      <div>
        <div class="prose">{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
        {milestones.length > 0 && <div class="milestones">{milestones.map((item) => <div class="milestone">
          <span>{item.year}</span>
          <div class="milestone__content">
            <p><strong>{item.text}</strong></p>
            {item.details && item.details.length > 0 && <ul>{item.details.map((detail) => {
              const [name, description] = detail.split(' – ');
              return <li>{description ? <><strong>{name}</strong> – {description}</> : detail}</li>;
            })}</ul>}
          </div>
        </div>)}</div>}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero { padding-block: var(--hero-space) 0; }
  .portrait { position: sticky; top: 9rem; overflow: hidden; aspect-ratio: 3 / 4; padding: 0; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-sage-soft); }
  .prose { display: grid; gap: 1rem; }
  .portrait :global(img) { width: 100%; height: 100%; border-radius: var(--radius-lg); object-fit: cover; object-position: 28% center; box-shadow: var(--shadow-soft); }
  .milestones { margin-top: 3rem; }
  .milestone { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--color-sand); }
  .milestone > span { color: var(--color-clay); font-weight: 700; }
  .milestone__content { color: var(--color-steel); }
  .milestone__content ul { display: grid; gap: 0.35rem; margin: 0.75rem 0 0; padding-left: 1.25rem; }
  @media (max-width: 47.99rem) {
    .portrait { position: static; }
    .milestone { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
