---
import { Image } from 'astro:assets';
import visitCardHandpan from '../assets/images/originals/klangfonia-visitenkarte-handpan.png';
import visitCardWordmark from '../assets/images/originals/klangfonia-visitenkarte-wordmark.png';
---
<span class="brand-lockup" aria-hidden="true" style="display: inline-flex; flex-direction: row; align-items: center;">
  <Image
    class="brand-handpan"
    src={visitCardHandpan}
    alt=""
    width={188}
    widths={[152, 168, 188]}
    sizes="(max-width: 24rem) 76px, (max-width: 59.99rem) 84px, 94px"
    format="png"
    loading="eager"
  />
  <Image
    class="brand-wordmark"
    src={visitCardWordmark}
    alt=""
    width={272}
    widths={[216, 240, 272]}
    sizes="(max-width: 24rem) 108px, (max-width: 59.99rem) 120px, 136px"
    format="png"
    loading="eager"
  />
</span>
<style>
  .brand-lockup { display: inline-flex; align-items: center; gap: 0; color: var(--color-ink); }
  .brand-handpan { display: block; width: 5.875rem; height: auto; }
  .brand-wordmark { display: block; width: 8.5rem; height: auto; margin-left: 0.5rem; }
  @media (max-width: 59.99rem) {
    .brand-handpan { width: 5.25rem; }
    .brand-wordmark { width: 7.5rem; margin-left: 0.4rem; }
  }
  @media (max-width: 24rem) {
    .brand-handpan { width: 4.75rem; }
    .brand-wordmark { width: 6.75rem; margin-left: 0.35rem; }
  }
</style>
