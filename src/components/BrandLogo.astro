---
import { Image } from 'astro:assets';
import visitCardLockup from '../assets/images/originals/klangfonia-visitenkarte-lockup.png';
---
<span class="brand-lockup" aria-hidden="true" style="display: inline-flex; flex-direction: row; align-items: center;">
  <Image
    class="brand-lockup-image"
    src={visitCardLockup}
    alt=""
    width={508}
    widths={[300, 380, 508]}
    sizes="(max-width: 24rem) 150px, (max-width: 59.99rem) 170px, 190px"
    format="png"
    loading="eager"
  />
</span>
<style>
  .brand-lockup { display: inline-flex; align-items: center; color: var(--color-ink); }
  .brand-lockup-image { display: block; width: 11.875rem; height: auto; }
  @media (max-width: 59.99rem) {
    .brand-lockup-image { width: 10.625rem; }
  }
  @media (max-width: 24rem) {
    .brand-lockup-image { width: 9.375rem; }
  }
</style>
