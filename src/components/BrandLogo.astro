---
import { Image } from 'astro:assets';
import symbol from '../assets/images/logo-transparent.png';
---
<span class="brand-lockup" aria-hidden="true">
  <span class="brand-instrument">
    <Image class="brand-symbol" src={symbol} alt="" width={144} densities={[1, 2, 3]} format="png" loading="eager" />
  </span>
</span>
<style>
  .brand-lockup { display: inline-flex; flex-direction: column; align-items: center; color: var(--color-ink); }
  .brand-instrument { position: relative; display: block; }
  .brand-instrument::after { content: ''; position: absolute; inset: 13% 17% 16%; border: 1px solid var(--color-clay); border-radius: 50%; opacity: 0; pointer-events: none; }
  .brand-symbol { display: block; width: calc(8rem * var(--brand-scale, 1)); height: auto; }
  @media (max-width: 59.99rem) { .brand-symbol { width: calc(6.5rem * var(--brand-scale, 1)); } }
  @media (prefers-reduced-motion: no-preference) {
    .brand-instrument::after { animation: handpan-resonance 1.8s ease-out 500ms 2; }
    :global(a:focus-visible) .brand-instrument::after { animation: handpan-resonance-focus 1.8s ease-out; }
    @media (hover: hover) {
      .brand-lockup:hover .brand-instrument::after { animation: handpan-resonance-focus 1.8s ease-out; }
    }
  }
  @keyframes handpan-resonance {
    0% { opacity: 0; transform: scale(0.9); }
    20% { opacity: 0.35; }
    100% { opacity: 0; transform: scale(1.35); }
  }
  @keyframes handpan-resonance-focus {
    0% { opacity: 0; transform: scale(0.9); }
    20% { opacity: 0.35; }
    100% { opacity: 0; transform: scale(1.35); }
  }
</style>
