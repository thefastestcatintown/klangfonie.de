---
import { Image } from 'astro:assets';
import symbol from '../assets/images/klangfonia-logo2-transparent.png';
const arcId = `brand-arc-${crypto.randomUUID()}`;
---
<span class="brand-lockup" aria-hidden="true">
  <span class="brand-instrument">
    <Image class="brand-symbol" src={symbol} alt="" width={144} height={96} densities={[1, 2, 3]} format="png" loading="eager" />
  </span>
  <svg class="brand-word" viewBox="0 0 240 100" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <defs><path id={arcId} d="M 4 20 Q 120 114 236 20" /></defs>
    <text text-anchor="middle" transform="rotate(-28 120 -35)"><textPath href={`#${arcId}`} startOffset="50%"><tspan class="brand-initial">K</tspan><tspan dx="2">langfonia</tspan></textPath></text>
  </svg>
</span>
<style>
  .brand-lockup { display: inline-flex; flex-direction: column; align-items: center; color: var(--color-ink); }
  .brand-instrument { position: relative; display: block; }
  .brand-instrument::after { content: ''; position: absolute; inset: 13% 17% 16%; border: 1px solid var(--color-clay); border-radius: 50%; opacity: 0; pointer-events: none; }
  .brand-symbol { display: block; width: calc(8rem * var(--brand-scale, 1)); height: auto; }
  .brand-word { display: block; width: calc(13rem * var(--brand-scale, 1)); height: auto; margin-top: calc(-1.1rem * var(--brand-scale, 1)); overflow: visible; fill: currentColor; font-family: var(--font-display); font-size: 35px; font-weight: 400; letter-spacing: -0.4px; }
  .brand-initial { fill: var(--color-clay-dark); font-family: var(--font-accent); font-size: 59px; letter-spacing: 0; }
  @media (max-width: 59.99rem) { .brand-symbol { width: calc(6.5rem * var(--brand-scale, 1)); } .brand-word { width: calc(11rem * var(--brand-scale, 1)); margin-top: calc(-0.9rem * var(--brand-scale, 1)); } }
  @media (prefers-reduced-motion: no-preference) {
    .brand-symbol { transform-origin: 50% 65%; animation: handpan-welcome 4.6s ease-in-out both; }
    .brand-instrument { transition: transform 650ms cubic-bezier(0.22, 1, 0.36, 1); }
    .brand-instrument::after { animation: handpan-resonance 1.8s ease-out 500ms 2; }
    :global(a:focus-visible) .brand-instrument { transform: translateY(-2px) rotate(-3deg); }
    :global(a:focus-visible) .brand-instrument::after { animation: handpan-resonance-focus 1.8s ease-out; }
    @media (hover: hover) {
      .brand-lockup:hover .brand-instrument { transform: translateY(-2px) rotate(-3deg); }
      .brand-lockup:hover .brand-instrument::after { animation: handpan-resonance-focus 1.8s ease-out; }
    }
  }
  @keyframes handpan-welcome {
    0%, 100% { transform: translateY(0) rotate(0); }
    20% { transform: translateY(-2px) rotate(-3deg); }
    45% { transform: translateY(0) rotate(1.5deg); }
    70% { transform: translateY(-1px) rotate(-1deg); }
  }
  @keyframes handpan-resonance {
    0% { opacity: 0; transform: scale(0.9); }
    20% { opacity: 0.35; }
    100% { opacity: 0; transform: scale(1.35); }
  }
  @keyframes handpan-resonance-focus {
    0% { opacity: 0; transform: scale(0.9); }
    20% { opacity: 0.35; }
    100% { opacity: 0; transform: scale(1.35); }
  }
</style>
