---
import type { Testimonial } from '../lib/types';
import type { Language } from '../lib/i18n';
interface Props { testimonial: Testimonial; isExample?: boolean; lang?: Language; }
const { testimonial, isExample = false, lang = 'de' } = Astro.props;
const sourceType = lang === 'en' && testimonial.sourceType === 'Schüler:in' ? 'Student' : testimonial.sourceType;
---
<figure class="testimonial">
  {isExample && <span class="example-label">{lang === 'en' ? 'Example' : 'Beispiel'}</span>}
  <span class="quote-mark" aria-hidden="true">“</span>
  <blockquote>{lang === 'en' ? `“${testimonial.quote}”` : `„${testimonial.quote}“`}</blockquote>
  <figcaption>
    <strong>{testimonial.name}</strong>
    {(sourceType || testimonial.context) && (
      <span>{[sourceType, testimonial.context].filter(Boolean).join(' · ')}</span>
    )}
  </figcaption>
</figure>
<style>
  .testimonial {
    position: relative;
    height: 100%;
    margin: 0;
    padding: clamp(2rem, 4vw, 3.5rem);
    overflow: hidden;
    border: 1px solid rgb(38 53 47 / 0.1);
    border-radius: var(--radius-lg);
    background: rgb(255 253 247 / 0.72);
  }
  .quote-mark {
    position: absolute;
    top: -1.6rem;
    right: 1.25rem;
    color: rgb(165 93 58 / 0.13);
    font-family: var(--font-display);
    font-size: clamp(9rem, 17vw, 14rem);
    line-height: 1;
    pointer-events: none;
  }
  .example-label {
    position: relative;
    z-index: 1;
    display: inline-flex;
    margin-bottom: 1.25rem;
    padding: 0.32rem 0.65rem;
    border: 1px solid rgb(155 96 62 / 0.3);
    border-radius: 999px;
    color: var(--color-clay-dark);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }
  blockquote {
    position: relative;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.15rem);
    line-height: 1.38;
    text-wrap: pretty;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    color: var(--color-steel);
    font-size: 0.84rem;
  }
  strong { color: var(--color-ink); font-size: 0.9rem; }
  figcaption span { opacity: 0.85; }
</style>
