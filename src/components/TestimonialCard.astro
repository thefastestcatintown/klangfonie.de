---
import type { Testimonial } from '../lib/types';
interface Props { testimonial: Testimonial; }
const { testimonial } = Astro.props;
---
<figure class="testimonial">
  <blockquote>„{testimonial.quote}“</blockquote>
  <figcaption><strong>{testimonial.name}</strong>{testimonial.context && <span>{testimonial.context}</span>}</figcaption>
</figure>
<style>
  .testimonial { margin: 0; padding: 2rem; border: 1px solid rgb(36 55 70 / 0.12); border-radius: var(--radius-md); background: var(--color-white); }
  blockquote { margin: 0; color: var(--color-ink); font-family: var(--font-display); font-size: 1.45rem; line-height: 1.35; }
  figcaption { display: flex; flex-direction: column; margin-top: 2rem; color: var(--color-steel); font-size: 0.85rem; } strong { color: var(--color-ink); } span { opacity: 0.8; }
</style>
