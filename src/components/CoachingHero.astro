---
import { navigationFor } from '../lib/navigation';
import { contentPath, languageFromPath, localizePath, type Language } from '../lib/i18n';
import DecorativeHeading from './DecorativeHeading.astro';
interface Props { title: string; intro: string; lang?: Language; }
const { title, intro, lang = languageFromPath(Astro.url.pathname) } = Astro.props;
const current = contentPath(Astro.url.pathname);
const { coachingLinks } = navigationFor(lang);
---
<section class="page-hero coaching-hero">
  <div class="container page-hero__inner">
    <p class="coaching-eyebrow">Handpan · Coaching</p>
    <DecorativeHeading level="h1" class="page-title" text={title} />
    <p class="lead">{intro}</p>
    <nav class="coaching-tabs" aria-label={lang === 'en' ? 'Coaching services' : 'Coaching-Angebote'}>
      {coachingLinks.map(({ href, label }) => <a href={localizePath(href, lang)} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</section>
