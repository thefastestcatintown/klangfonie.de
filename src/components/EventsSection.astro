---
import { getEvents, getPageCopy, imageSrcSet, imageUrl } from '../lib/sanity';
import { formatEventSchedule } from '../lib/dates';
import DecorativeHeading from './DecorativeHeading.astro';
import { languageFromPath } from '../lib/i18n';
import { localizeEvent } from '../lib/event-translations';
import { defaultsFor } from '../content/page-copy-defaults';
import { expandRecurringEvents } from '../lib/event-recurrence';
interface Props { heading?: string; headingLevel?: 'h1' | 'h2'; intro?: string; limit?: number; layout?: 'cards' | 'list'; }
const { heading, headingLevel = 'h2', intro, limit, layout = 'cards' } = Astro.props;
const rawEvents = await getEvents();
const language = languageFromPath(Astro.url.pathname);
const allEvents = expandRecurringEvents(rawEvents).map((event) => localizeEvent(event, language));
const events = typeof limit === 'number' ? allEvents.slice(0, limit) : allEvents;
const globalCopy = await getPageCopy('global', language, defaultsFor('global', language));
const copy = { heading: language === 'en' ? 'Concerts & events' : 'Konzerte & Termine', more: globalCopy.eventMore, book: globalCopy.eventBook, empty: globalCopy.eventEmpty };
if (heading) copy.heading = heading;
const eventHeadingLevel = headingLevel === 'h1' ? 'h2' : 'h3';
const EventHeading = eventHeadingLevel;
const sanityProjectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
const sanityDataset = import.meta.env.PUBLIC_SANITY_DATASET || 'production';

---
  <section
    class="section section--linen"
    id="termine"
    data-events-section
    data-project-id={sanityProjectId}
    data-dataset={sanityDataset}
    data-language={language}
    data-more-label={copy.more}
    data-book-label={copy.book}
    data-empty-label={copy.empty}
    data-limit={limit}
    data-layout={layout}
    data-event-heading-level={eventHeadingLevel}
  >
    <div class="container">
      <DecorativeHeading level={headingLevel} class="page-title" text={copy.heading} />
      {intro && <p class="events-intro">{intro}</p>}
      <div class:list={['events', `events--${layout}`, { 'events--single': layout === 'cards' && events.length === 1 }]} data-events-list aria-live="polite">
        {events.length > 0 ? events.map((event) => {
          const eventImage = imageUrl(event.image, 1280, 720);
          const eventImageSrcSet = imageSrcSet(event.image, [480, 720, 960, 1280], 9 / 16);
          const eventImageAlt = language === 'en' ? (event.image?.altEn || event.image?.alt || event.title) : (event.image?.alt || event.title);
          return (
            <article class:list={{ 'has-image': eventImage }}>
              <header class="event-meta">
                {event.date
                  ? <time class="event-date" datetime={event.date}>{formatEventSchedule(event.date, event.endDate, event.planningLabel, language)}</time>
                  : <p class="event-date">{formatEventSchedule(undefined, undefined, event.planningLabel, language)}</p>}
              </header>
              {eventImage && <img class="event-image" src={eventImage} srcset={eventImageSrcSet} sizes={layout === 'list' ? '(min-width: 52rem) 28vw, calc(100vw - 2rem)' : '(min-width: 64rem) 33vw, calc(100vw - 2rem)'} alt={eventImageAlt} width="960" height="540" loading="lazy" decoding="async" />}
              <div class="event-content">
                <EventHeading>{event.title}</EventHeading>
                <p class="event-location">{event.location}</p>
                <p>{event.description}</p>
                {event.externalUrl && <a href={event.externalUrl} target="_blank" rel="noreferrer">{event.ctaType === 'book' ? copy.book : copy.more} ↗</a>}
              </div>
            </article>
          );
        }) : (
          <p class="events-empty">{copy.empty}</p>
        )}
      </div>
    </div>
  </section>

<script>import '../scripts/events';</script>

<style>
  section { background: var(--color-white); }
  .events-intro { max-width: 46rem; margin-top: 1rem; color: var(--color-steel); font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.7; }
  .events { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); margin-top: clamp(1.5rem, 4vw, 3rem); }
  .events--single { max-width: 64rem; }
  .events :global(article) { display: flex; min-width: 0; overflow: hidden; flex-direction: column; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-linen); box-shadow: var(--shadow-soft); }
  .events :global(.event-meta) { padding: 1rem clamp(1.25rem, 3vw, 2rem); border-bottom: 1px solid var(--color-border); background: linear-gradient(90deg, rgb(155 96 62 / 0.1), transparent 70%); }
  .events :global(.event-date) { display: inline-flex; align-items: center; gap: 0.55rem; margin: 0; color: var(--color-clay-dark); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.035em; }
  .events :global(.event-date)::before { content: ''; width: 0.5rem; height: 0.5rem; flex: 0 0 auto; border-radius: 50%; background: var(--color-clay); box-shadow: 0 0 0 0.3rem rgb(155 96 62 / 0.12); }
  .events :global(.event-image) { width: 100%; height: auto; aspect-ratio: 16 / 9; border-bottom: 1px solid var(--color-border); object-fit: cover; object-position: center 32%; }
  .events :global(.event-content) { display: flex; flex: 1; align-items: flex-start; flex-direction: column; padding: clamp(1.35rem, 3vw, 2.25rem); }
  .events :global(h2), .events :global(h3) { max-width: 32ch; font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height: 1.18; }
  .events :global(p) { color: var(--color-steel); line-height: 1.7; }
  .events :global(.event-location) { position: relative; margin: 0.75rem 0 1rem; padding-left: 1.15rem; color: var(--color-ink); font-size: 0.88rem; font-weight: 700; line-height: 1.55; }
  .events :global(.event-location)::before { content: ''; position: absolute; top: 0.55em; left: 0; width: 0.45rem; height: 0.45rem; border: 1px solid var(--color-clay); border-radius: 50%; }
  .events :global(a) { display: inline-flex; align-items: center; margin-top: 1.35rem; padding: 0.65rem 1rem; border: 1px solid rgb(41 59 50 / 0.22); border-radius: 99rem; color: var(--color-ink); font-size: 0.82rem; font-weight: 700; text-decoration: none; transition: border-color 180ms ease, color 180ms ease, transform 180ms ease; }
  .events :global(a:hover) { border-color: var(--color-clay); color: var(--color-clay-dark); transform: translateY(-2px); }
  .events :global(.events-empty) { padding: 1.75rem 0; border-block: 1px solid var(--color-border); font-size: 1.05rem; }
  @media (min-width: 52rem) {
    .events--list { gap: 0; }
    .events--list :global(article) {
      display: grid;
      grid-template-areas: 'image meta' 'image content';
      grid-template-columns: minmax(17rem, 0.78fr) minmax(0, 1.22fr);
      grid-template-rows: auto 1fr;
      padding-block: clamp(1.75rem, 3vw, 2.75rem);
      overflow: visible;
      border: 0;
      border-bottom: 1px solid var(--color-border);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .events--list :global(article:first-child) { padding-top: 0; }
    .events--list :global(.event-meta) {
      grid-area: meta;
      padding: 0 0 1rem clamp(1.75rem, 4vw, 3.5rem);
      border: 0;
      background: transparent;
    }
    .events--list :global(.event-image) {
      grid-area: image;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 9;
      border: 0;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-soft);
    }
    .events--list :global(.event-content) {
      grid-area: content;
      padding: 0 0 0 clamp(1.75rem, 4vw, 3.5rem);
    }
  }
  @media (min-width: 64rem) { .events--cards:not(.events--single) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
