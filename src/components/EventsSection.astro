---
import { getEvents, imageUrl } from '../lib/sanity';
import { formatEventDate } from '../lib/dates';
const events = await getEvents();
const sanityProjectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
const sanityDataset = import.meta.env.PUBLIC_SANITY_DATASET || 'production';

---
  <section
    class="section section--linen"
    id="termine"
    data-events-section
    data-project-id={sanityProjectId}
    data-dataset={sanityDataset}
  >
    <div class="container">
      <h2>Konzerte & Termine</h2>
      <div class="events" data-events-list aria-live="polite">
        {events.length > 0 ? events.map((event) => {
          const eventImage = imageUrl(event.image, 640, 426);
          return (
            <article>
              <time datetime={event.date}>{formatEventDate(event.date, event.endDate)}</time>
              <div class:list={['event-details', { 'has-image': eventImage }]}>
                {eventImage && <img class="event-image" src={eventImage} alt={event.image?.alt || event.title} width="640" height="426" loading="lazy" />}
                <div>
                  <h3>{event.title}</h3>
                  <p class="event-location">{event.location}</p>
                  <p>{event.description}</p>
                </div>
              </div>
              {event.externalUrl && <a href={event.externalUrl} target="_blank" rel="noreferrer">Mehr erfahren ↗</a>}
            </article>
          );
        }) : (
          <p class="events-empty">Neue Konzerttermine werden hier veröffentlicht.</p>
        )}
      </div>
    </div>
  </section>

<script>import '../scripts/events';</script>

<style>
  section { background: var(--color-white); }
  .events { display: grid; margin-top: 1.25rem; border-top: 1px solid var(--color-border); }
  .events :global(article) { display: grid; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); }
  .events :global(time) { color: var(--color-clay); font-size: 0.82rem; font-weight: 700; }
  .events :global(h3) { font-size: 1.5rem; }
  .events :global(p) { color: var(--color-steel); }
  .events :global(.event-details) { display: grid; gap: 1.25rem; }
  .events :global(.event-image) { width: 100%; aspect-ratio: 3 / 2; border-radius: 1rem; object-fit: cover; }
  .events :global(.event-location) { margin-top: 0.4rem; color: var(--color-ink); font-weight: 700; }
  .events :global(a) { align-self: start; color: var(--color-ink); font-weight: 700; }
  .events :global(.events-empty) { padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); font-size: 1.05rem; }
  @media (min-width: 40rem) { .events :global(.event-details.has-image) { grid-template-columns: minmax(10rem, 15rem) 1fr; } }
  @media (min-width: 48rem) { .events :global(article) { grid-template-columns: 12rem 1fr auto; } }
</style>
