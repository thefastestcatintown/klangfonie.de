---
import { Image } from 'astro:assets';
import danielaPortrait from '../assets/images/daniela-handpan-portrait.png';
import Button from './Button.astro';
---
<section class="section about-preview" id="ueber-daniela">
  <div class="container about-grid">
    <figure class="about-image">
      <Image src={danielaPortrait} alt="Daniela Schneider mit ihrer Handpan in einem sonnigen Garten" width={820} height={1456} />
      <figcaption>Im Klang zuhause</figcaption>
    </figure>
    <div class="about-copy">
      <h2>Ich bin Daniela.</h2>
      <div class="copy">
        <p>Handpan-Spielerin, Musikerin und Lernbegleiterin. Ich möchte Menschen ins Spielen bringen und mit Musik verbinden – mit Neugier, Freude und Raum für den eigenen Ausdruck.</p>
      </div>
      <Button href="/ueber-daniela" variant="secondary">Über mich</Button>
    </div>
  </div>
</section>
<style>
  .about-preview { overflow: hidden; background: var(--color-white); }
  .about-grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .about-image { position: relative; aspect-ratio: 1 / 1; max-width: 24rem; margin: 0; padding: 0 0 1.25rem 1.25rem; }
  .about-image::before { content: ''; position: absolute; inset: 3rem auto 0 0; width: calc(100% - 1.25rem); border-radius: 1.4rem; background: var(--color-sage-soft); }
  .about-image :global(img) { position: relative; width: 100%; height: 100%; border-radius: 10rem 1.5rem 1.5rem 1.5rem; object-fit: cover; object-position: 70% top; box-shadow: var(--shadow-soft); }
  figcaption { position: absolute; right: -1rem; bottom: 2.5rem; padding: 0.65rem 1rem; border-radius: 99rem; background: var(--color-clay); color: white; font-size: 0.67rem; font-weight: 750; letter-spacing: 0.11em; text-transform: uppercase; }
  .about-copy { max-width: 40rem; }
  h2 { max-width: 100%; font-size: clamp(2.4rem, 4vw, 3.5rem); text-wrap: balance; }
  .copy { display: grid; gap: 1rem; max-width: 39rem; margin: 1.75rem 0 2.25rem; color: var(--color-steel); }
  @media (min-width: 50rem) { .about-grid { grid-template-columns: minmax(16rem, 24rem) minmax(0, 1fr); } }
  @media (max-width: 32rem) { figcaption { right: 0; } }
</style>
