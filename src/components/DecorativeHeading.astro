---
interface Props {
  level: 'h1' | 'h2';
  text: string;
  id?: string;
  class?: string;
  gap?: string;
}

const { level: Tag, text, id, class: className, gap } = Astro.props;
const heading = text.trim();
const firstWhitespace = heading.search(/\s/);
const firstWord = firstWhitespace === -1 ? heading : heading.slice(0, firstWhitespace);
const remainder = firstWhitespace === -1 ? '' : heading.slice(firstWhitespace);
const initial = firstWord.charAt(0);
const firstWordRemainder = firstWord.slice(1);
const gaps: Record<string, string> = {
  // The Great Vibes K extends well beyond its advance width. Keep the following
  // letter clear of the swash, especially in narrow mobile WebViews.
  Kl: '0.32em',
  Ko: '0.08em',
  Le: '0.08em',
  Lu: '0.06em',
  Li: '0.06em',
  Me: '0.07em',
  Mu: '0.07em',
  De: '0.05em',
  Di: '0.04em',
  Da: '0.05em',
  Wa: '0.05em',
  Ha: '0.04em',
};
const initialGap = gap ?? gaps[heading.slice(0, 2)] ?? '0.025em';
---
<Tag id={id} class={className}><span class="decorative-first-word"><span class="decorative-initial" style={`--initial-gap: ${initialGap}`}>{initial}</span>{firstWordRemainder}</span>{remainder}</Tag>

<style>
  .decorative-first-word {
    white-space: nowrap;
  }

  .decorative-initial {
    display: inline-block;
    margin-right: var(--initial-gap);
    color: var(--color-clay);
    font-family: var(--font-accent);
    font-size: 1.24em;
    letter-spacing: 0;
    line-height: 1.5;
  }
</style>
