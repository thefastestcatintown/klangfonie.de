---
import BrandLogo from './BrandLogo.astro';
import { withBase } from '../lib/urls';

const pathname = Astro.url.pathname.replace(/\/$/, '');
const coachingLinks = [
  { href: withBase('/unterricht'), label: 'Lernbegleitung 1:1' },
  { href: withBase('/ensemble'), label: 'Big Band' },
  { href: withBase('/workshops'), label: 'Workshops' },
];
const navigation = [
  { href: withBase('/yoga'), label: 'Retreats' },
  { href: withBase('/live'), label: 'Musik' },
  { href: withBase('/ueber-daniela'), label: 'Über mich' },
  { href: withBase('/kontakt'), label: 'Kontakt' },
];
---
<header class="site-header" data-header>
  <div class="header-inner container">
    <a class="brand" href={withBase('/')} aria-label="Klangfonia – Startseite">
      <BrandLogo />
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-navigation" data-menu-button>
      <span class="sr-only">Menü öffnen</span><i></i><i></i>
    </button>
    <nav class="navigation" id="main-navigation" aria-label="Hauptnavigation" data-navigation>
      <details class:list={['coaching-menu', { 'is-current': coachingLinks.some((item) => pathname === item.href) }]} data-coaching-menu>
        <summary>Coaching <span class="chevron" aria-hidden="true">⌄</span></summary>
        <ul class="submenu">
          {coachingLinks.map((item) => <li><a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a></li>)}
        </ul>
      </details>
      {navigation.map((item) => <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a>)}

    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLElement>('[data-menu-button]');
  const navigation = document.querySelector<HTMLElement>('[data-navigation]');
  const coaching = document.querySelector<HTMLDetailsElement>('[data-coaching-menu]');
  const closeMenu = () => {
    button?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
    if (coaching) coaching.open = false;
  };
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !coaching?.contains(event.target) && coaching) coaching.open = false;
  });
  coaching?.addEventListener('focusout', (event) => {
    if (!(event.relatedTarget instanceof Node) || !coaching.contains(event.relatedTarget)) coaching.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (coaching?.open) {
      coaching.open = false;
      coaching.querySelector('summary')?.focus();
    } else if (button?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      button.focus();
    }
  });
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    document.body.classList.toggle('menu-open', !open);
  });
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  window.addEventListener('resize', () => { if (window.innerWidth >= 960) closeMenu(); });
</script>
<style>
  .site-header { --header-height: 8rem; position: sticky; top: 0; z-index: 50; border-bottom: 1px solid rgb(38 53 47 / 0.08); background: rgb(255 253 247 / 0.9); backdrop-filter: blur(16px); }
  .header-inner { display: flex; min-height: var(--header-height); align-items: center; justify-content: space-between; padding-block: 0.25rem; }
  .brand { --brand-scale: 0.78; display: inline-flex; align-items: center; gap: 0.75rem; flex-shrink: 0; color: var(--color-ink); font-family: var(--font-display); font-size: 1.7rem; letter-spacing: -0.025em; text-decoration: none; }

  .navigation { display: flex; align-items: center; gap: clamp(1rem, 2.2vw, 2rem); }
  .navigation > a { position: relative; color: var(--color-ink); font-size: 0.8rem; font-weight: 700; text-decoration: none; }
  .navigation > a::after { content: ''; position: absolute; right: 0; bottom: -0.5rem; left: 0; height: 1px; transform: scaleX(0); background: var(--color-clay); transition: transform 180ms ease; }
  .navigation > a:hover::after, .navigation > a[aria-current='page']::after { transform: scaleX(1); }
  .coaching-menu { position: relative; }
  .coaching-menu summary { display: flex; align-items: center; gap: 0.45rem; color: var(--color-ink); font-size: 0.8rem; font-weight: 700; cursor: pointer; list-style: none; }
  .coaching-menu summary::-webkit-details-marker { display: none; }
  .coaching-menu.is-current summary, .coaching-menu summary:hover { color: var(--color-clay); }
  .chevron { transition: transform 180ms ease; }
  .coaching-menu[open] .chevron { transform: rotate(180deg); }
  .submenu { position: absolute; top: calc(100% + 1rem); left: -1rem; width: 18rem; margin: 0; padding: 0.5rem; list-style: none; border: 1px solid var(--color-sand); border-radius: 0.75rem; background: var(--color-white); box-shadow: var(--shadow-soft); }
  .submenu a { display: block; padding: 0.8rem; border-radius: 0.4rem; color: var(--color-ink); font-size: 0.85rem; text-decoration: none; }
  .submenu a:hover, .submenu a:focus-visible, .submenu a[aria-current='page'] { background: var(--color-linen); }

  .menu-button { display: none; width: 2.8rem; height: 2.8rem; border: 1px solid rgb(38 53 47 / 0.15); border-radius: 50%; background: transparent; }
  .menu-button i { display: block; width: 1.5rem; height: 1px; margin: 0.4rem auto; background: var(--color-ink); transition: transform 180ms ease; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  @media (max-width: 59.99rem) {
    .site-header { --header-height: 7rem; }
    .header-inner { padding-block: 0.25rem; }
    .brand { font-size: 1.5rem; }

    .menu-button { display: block; }
    .menu-button[aria-expanded='true'] i:first-of-type { transform: translateY(0.2rem) rotate(45deg); }
    .menu-button[aria-expanded='true'] i:last-of-type { transform: translateY(-0.2rem) rotate(-45deg); }
    .navigation { position: fixed; inset: var(--header-height) 0 auto; display: none; height: calc(100dvh - var(--header-height)); overflow-y: auto; align-items: stretch; flex-direction: column; gap: 0; padding: 2rem 1rem; background: var(--color-linen); }
    .menu-button[aria-expanded='true'] + .navigation { display: flex; }
    .navigation > a, .coaching-menu summary { padding: 1rem; border-bottom: 1px solid rgb(36 55 70 / 0.14); font-family: var(--font-display); font-size: 1.65rem; font-weight: 400; }
    .coaching-menu summary { justify-content: space-between; }
    .submenu { position: static; width: auto; margin: 0.5rem 1rem 1rem; padding: 0 0 0 0.75rem; border: 0; border-left: 1px solid var(--color-sand); border-radius: 0; background: transparent; box-shadow: none; }
    .submenu a { font-size: 1rem; }

  }
  @media (max-width: 24rem) {
    .site-header { --header-height: 7rem; }
    .header-inner { padding-block: 0.25rem; }
    .brand { gap: 0.3rem; font-size: 1.3rem; }

  }
  @media (prefers-reduced-motion: no-preference) {
    .coaching-menu[open] .submenu { animation: menu-appear 180ms ease-out; }
    @keyframes menu-appear { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }
  }
</style>
