---
import ServicePage from '../components/ServicePage.astro';
import yogaImage from '../assets/images/sample-yoga-handpan.png';
import { getService } from '../lib/sanity';
import type { Language } from '../lib/i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const english = lang === 'en';
const service = await getService('Yoga');
---
<ServicePage
  service={service}
  lang={lang}
  title={english ? 'Experience music. Feel rhythm. Share connection.' : 'Musik erleben. Rhythmus spüren. Gemeinschaft fühlen.'}
  fallbackImage={yogaImage}
  fallbackImageAlt={english ? 'Copper-coloured handpan in a bright retreat space' : 'Kupferfarbene Handpan in einem hellen Yogaraum'}
  ctaLabel={english ? 'Enquire about a retreat' : 'Retreat anfragen'}
  ctaUrl="/kontakt?interesse=yoga"
  fallbackBody={english ? [
    'Immerse yourself in the world of handpan sounds, carried by rhythm in motion. In my retreats, handpan music and shared body percussion come together – an inspiring combination of mindfulness, musical experience and collective expression.',
  ] : [
    'Tauche ein in die Welt der Handpansounds getragen von Rhythmus in Bewegung. In meinen Retreats begegnen sich Handpanmusik und gemeinsame Bodypercussion – eine inspirierende Verbindung aus Achtsamkeit, musikalischem Erleben und gemeinschaftlichem Ausdruck.',
  ]}
  bullets={english ? [
    'Handpan: Immerse yourself in ethereal sounds and let their depth move you.',
    'Body percussion: Experience movement and rhythm with your whole body, feel alive and find a shared flow.',
  ] : [
    'Handpan: In sphärische Klänge eintauchen und sich von ihrer Tiefe berühren lassen.',
    'Bodypercussion: Bewegung und Rhythmus mit dem ganzen Körper erfahren, Lebendigkeit spüren und gemeinsam in den Flow kommen.',
  ]}
  closingBody={english ? [
    'Whether in quiet moments or powerful ensemble playing, space opens up for new experiences, musical vitality and connection.',
    'You do not need any musical experience. All you need is an openness to handpan sounds, rhythm in motion and meeting others.',
    'Carried by music. Together in rhythm. Connected in the moment.',
  ] : [
    'Ob in stillen Momenten oder im kraftvollen Zusammenspiel – es entsteht Raum für neue Erfahrungen, musikalische Lebendigkeit und Verbundenheit.',
    'Du brauchst keine musikalischen Vorkenntnisse. Alles, was du mitbringst, ist die Offenheit, dich auf die Handpansounds, Rhythmus in Bewegung und Begegnung einzulassen.',
    'Getragen von der Musik. Gemeinsam im Rhythmus. Verbunden im Augenblick.',
  ]}
 />

<section class="section partners-section" aria-labelledby="partners-title">
  <div class="container">
    <p class="partners-eyebrow">{english ? 'WORKING TOGETHER' : 'GEMEINSAM GESTALTEN'}</p>
    <h2 id="partners-title">{english ? 'Retreat partners' : 'Kooperationspartner für Retreats'}</h2>
    <p class="partners-intro">{english ? 'Examples of the kinds of partners who could shape a retreat with handpan and body percussion. These are placeholders, not current partners.' : 'Beispiele für mögliche Partner, mit denen Retreats mit Handpan und Bodypercussion entstehen können. Die Einträge sind Platzhalter und keine bestehenden Kooperationen.'}</p>
    <div class="partner-grid">
      <article class="partner-card"><span>01</span><h3>{english ? '[Yoga teacher / retreat host]' : '[Yoga-Leitung / Retreat-Veranstalter:in]'}</h3><p>{english ? 'Create a shared programme with movement, sound and rhythm.' : 'Ein gemeinsames Programm aus Bewegung, Klang und Rhythmus gestalten.'}</p></article>
      <article class="partner-card"><span>02</span><h3>{english ? '[Retreat venue / seminar house]' : '[Retreat-Ort / Seminarhaus]'}</h3><p>{english ? 'Add live handpan music and body percussion to a retreat setting.' : 'Live-Handpan und Bodypercussion in einen Retreat-Rahmen einbetten.'}</p></article>
      <article class="partner-card"><span>03</span><h3>{english ? '[Yoga studio / community]' : '[Yogastudio / Community]'}</h3><p>{english ? 'Offer a musical session or workshop for your community.' : 'Ein musikalisches Angebot oder einen Workshop für die eigene Community anbieten.'}</p></article>
    </div>
  </div>
</section>

<style>
  .partners-section { background: var(--color-linen); }
  .partners-eyebrow { margin-bottom: 0.65rem; color: var(--color-clay-dark); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; }
  .partners-section h2 { max-width: 20ch; }
  .partners-intro { max-width: 48rem; margin-top: 0.65rem; color: var(--color-steel); }
  .partner-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .partner-card { min-width: 0; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-white); }
  .partner-card > span { color: var(--color-clay); font-size: 0.8rem; }
  .partner-card h3 { margin-top: 0.75rem; font-size: clamp(1.2rem, 2vw, 1.55rem); line-height: 1.25; overflow-wrap: anywhere; }
  .partner-card p { margin-top: 0.65rem; color: var(--color-steel); }
  @media (max-width: 48rem) { .partner-grid { grid-template-columns: 1fr; } }
</style>
