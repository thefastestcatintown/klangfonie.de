---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CoachingHero from '../components/CoachingHero.astro';
import '../styles/coaching.css';
import Button from '../components/Button.astro';
import advancedWorkshopImage from '../assets/images/originals/sample-advanced-workshop.png';
import beginnerWorkshopImage from '../assets/images/originals/sample-beginner-workshop.png';
import { localizePath, type Language } from '../lib/i18n';
import { copyParagraphs, getPageCopy } from '../lib/sanity';
import { defaultsFor } from '../content/page-copy-defaults';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const copy = await getPageCopy('workshops', lang, defaultsFor('workshops', lang));
---

<BaseLayout lang={lang}>
  <div class="coaching-page">
  <CoachingHero lang={lang} title={copy.title} intro={copy.intro} />

  <section class="section workshops" id="workshops">
    <div class="container">
      <div class="workshop-grid">
        <article class="workshop-card coaching-card">
          <div class="workshop-image"><Image src={beginnerWorkshopImage} alt={copy.beginnerImageAlt} width={1200} /></div>
          <div class="workshop-content">
            <p class="coaching-eyebrow">{copy.beginnerEyebrow}</p>
            <h2>{copy.beginnerTitle}</h2>
            <div class="prose">
              {copyParagraphs(copy.beginnerIntro).map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <details>
              <summary>{copy.detailsLabel} <span aria-hidden="true">+</span></summary>
              <div class="prose details-content">
                {copyParagraphs(copy.beginnerDetails).map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </details>
            <div class="card-action"><Button href={localizePath('/kontakt?interesse=workshops', lang)}>{copy.cta}</Button></div>
          </div>
        </article>

        <article class="workshop-card coaching-card">
          <div class="workshop-image"><Image src={advancedWorkshopImage} alt={copy.advancedImageAlt} width={1200} /></div>
          <div class="workshop-content">
            <p class="coaching-eyebrow">{copy.advancedEyebrow}</p>
            <h2>{copy.advancedTitle}</h2>
            <div class="prose">
              {copyParagraphs(copy.advancedIntro).map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <details>
              <summary>{copy.detailsLabel} <span aria-hidden="true">+</span></summary>
              <div class="prose details-content">
                {copyParagraphs(copy.advancedDetails).map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </details>
            <div class="card-action"><Button href={localizePath('/kontakt?interesse=workshops', lang)}>{copy.cta}</Button></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  </div>
</BaseLayout>

<style>
  .workshop-grid {
    display: grid;
    gap: var(--coaching-gap);
  }


  .workshop-card {
    display: flex;
    overflow: hidden;
    flex-direction: column;
  }

  .workshop-image {
    overflow: hidden;
  }

  .workshop-image :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }

  .workshop-content { display: flex; flex: 1; flex-direction: column; padding: clamp(1.25rem, 2vw, 1.75rem); }
  .workshop-content h2 { margin-top: 0.65rem; }


  .workshop-content .prose { margin-top: 1rem; }
  details { margin-top: 2rem; border-top: 1px solid var(--color-sand); border-bottom: 1px solid var(--color-sand); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 0; color: var(--color-ink); font-size: 0.88rem; font-weight: 700; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--color-clay); font-size: 1.4rem; font-weight: 400; transition: transform 180ms ease; }
  details[open] summary span { transform: rotate(45deg); }
  .details-content { padding: 0 0 1.5rem; }
  .details-content p { white-space: pre-line; }
  .card-action { margin-top: auto; padding-top: 2rem; }


  @media (min-width: 54rem) { .workshop-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 60rem) and (max-height: 56rem) {
    .workshop-image :global(img) { aspect-ratio: 2 / 1; }
    .workshop-content { padding: 1.35rem; }
    details { margin-top: 1.25rem; }
    .card-action { padding-top: 1.25rem; }
  }
</style>
