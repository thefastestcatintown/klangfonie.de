---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import VideoSection from '../components/VideoSection.astro';
import DecorativeHeading from '../components/DecorativeHeading.astro';
import liveImage from '../assets/images/originals/sample-live-handpan.png';
import { copyParagraphs, getFeaturedVideo, getPageCopy, getService, imageSrcSet, imageUrl, localizeService } from '../lib/sanity';
import { defaultsFor } from '../content/page-copy-defaults';
import { localizePath, type Language } from '../lib/i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const [rawService, video] = await Promise.all([getService('Live'), getFeaturedVideo()]);
const service = localizeService(rawService, lang);
const copy = await getPageCopy('live', lang, defaultsFor('live', lang));
const image = imageUrl(service.image, 1200, 900);
const imageSources = imageSrcSet(service.image, [480, 800, 1200], 3 / 4);
---
<BaseLayout image={image} lang={lang}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <DecorativeHeading level="h1" class="page-title" text={copy.title} />
    </div>
  </section>

  <section class="section">
    <div class="container rich-layout">
      <div>
        {image ? (
          <div class="feature-image"><img src={image} srcset={imageSources} sizes="(min-width: 48rem) 42vw, calc(100vw - 2rem)" alt={service.image?.alt || copy.imageAlt} width="1200" height="900" loading="eager" fetchpriority="high" /></div>
        ) : (
          <div class="feature-image"><Image src={liveImage} alt={copy.imageAlt} width={1200} /></div>
        )}
      </div>
      <div>
        <div class="prose">
          {copyParagraphs(copy.body).map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <Button href={localizePath('/kontakt?interesse=live', lang)}>{copy.cta}</Button>
      </div>
    </div>
  </section>

  <VideoSection video={video} lang={lang} text={copy.videoIntro} />
</BaseLayout>
