---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import RichText from '../components/RichText.astro';
import VideoSection from '../components/VideoSection.astro';
import liveImage from '../assets/images/sample-live-handpan.png';
import { getFeaturedVideo, getService, imageUrl } from '../lib/sanity';
const [service, video] = await Promise.all([getService('Live'), getFeaturedVideo()]);
const image = imageUrl(service.image, 1200);
---
<BaseLayout image={image}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <h1>{service.headline}</h1>
      <p class="lead">Musik, die einem Anlass eine eigene Farbe gibt – solo, gemeinsam mit anderen Musiker:innen oder als fein abgestimmte Begleitung.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div>
        {image ? (
          <div class="feature-image"><img src={image} alt={service.image?.alt || service.title} width="1200" /></div>
        ) : (
          <div class="feature-image"><Image src={liveImage} alt="Handpan-Spieler bei einem kleinen, stimmungsvollen Konzert" width={1200} /></div>
        )}
      </div>
      <div>
        <RichText value={service.body} fallback={['Ob intimes Konzert, Retreat, Empfang oder besonderer Moment: Die musikalische Form entsteht passend zum Raum und zu den Menschen darin.', 'Je nach Anlass spielt Daniela solo oder entwickelt gemeinsam mit weiteren Musiker:innen ein passendes Set.']} />
        <ul class="live-list">
          <li>Konzerte & kleine Bühnen</li>
          <li>Retreats & Kulturveranstaltungen</li>
          <li>Feiern & besondere Momente</li>
          <li>Solo oder im Ensemble</li>
        </ul>
        <Button href={service.ctaUrl}>Live-Musik anfragen</Button>
      </div>
    </div>
  </section>

  <VideoSection video={video} headline="Ein Moment Musik." text="Lehn dich zurück und hör rein." />
</BaseLayout>

<style>
  .live-list { margin: 2rem 0; padding-left: 1.2rem; color: var(--color-ink); }
</style>
