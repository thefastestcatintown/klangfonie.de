---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ContactCTA from '../components/ContactCTA.astro';
import RichText from '../components/RichText.astro';
import { getEvents, getService, imageUrl } from '../lib/sanity';
const [service, events] = await Promise.all([getService('Live'), getEvents()]);
const image = imageUrl(service.image, 1200, 900);
---
<BaseLayout title="Live-Musik & Band – Klangfonie" description={service.shortDescription} image={image}>
  <section class="page-hero"><div class="container page-hero__inner"><p class="eyebrow">LIVE · BAND · EVENTS</p><h1>{service.headline}</h1><p class="lead">Musik, die einem Anlass eine eigene Farbe gibt – solo, gemeinsam mit anderen Musiker:innen oder als fein abgestimmte Begleitung.</p></div></section>
  <section class="section"><div class="container grid-2">
    <div>{image ? <div class="feature-image"><img src={image} alt={service.image?.alt || service.title} width="700" height="600" /></div> : <div class="image-placeholder">Live-Foto kann im Sanity Studio ergänzt werden.</div>}</div>
    <div><RichText value={service.body} fallback={['Ob intimes Konzert, Retreat, Empfang oder besonderer Moment: Die musikalische Form entsteht passend zum Raum und zu den Menschen darin.', 'Je nach Anlass spielt Daniela solo oder entwickelt gemeinsam mit weiteren Musiker:innen ein passendes Set.']} /><ul class="live-list"><li>Konzerte & kleine Bühnen</li><li>Retreats & Kulturveranstaltungen</li><li>Feiern & besondere Momente</li><li>Solo oder im Ensemble</li></ul><Button href={service.ctaUrl}>Live-Musik anfragen</Button></div>
  </div></section>
  {events.length > 0 && <section class="section section--linen"><div class="container"><p class="eyebrow">TERMINE</p><h2>Demnächst live</h2><div class="events">{events.map((event) => <article><time datetime={event.date}>{new Intl.DateTimeFormat('de-DE', { dateStyle: 'long', timeStyle: 'short' }).format(new Date(event.date))}</time><div><h3>{event.title}</h3><p>{event.location}</p><p>{event.description}</p></div>{event.externalUrl && <a href={event.externalUrl} target="_blank" rel="noreferrer">Mehr erfahren ↗</a>}</article>)}</div></div></section>}
  <ContactCTA />
</BaseLayout>
<style>
  .live-list { margin: 2rem 0; padding-left: 1.2rem; color: var(--color-ink); }
  .events { display: grid; margin-top: 3rem; border-top: 1px solid var(--color-sand); }
  .events article { display: grid; gap: 1rem; padding: 2rem 0; border-bottom: 1px solid var(--color-sand); }
  .events time { color: var(--color-clay); font-size: 0.82rem; font-weight: 700; }.events h3 { font-size: 1.8rem; }.events p { color: var(--color-steel); }.events a { align-self: start; color: var(--color-ink); font-weight: 700; }
  @media (min-width: 48rem) { .events article { grid-template-columns: 12rem 1fr auto; } }
</style>
