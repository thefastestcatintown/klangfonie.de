---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DecorativeHeading from '../../components/DecorativeHeading.astro';
import { getSettings } from '../../lib/sanity';

const settings = await getSettings();
---
<BaseLayout lang="en" title="Legal notice – Klangfonia" description="Legal notice for the Klangfonia website." noindex>
  <section class="page-hero"><div class="container page-hero__inner"><DecorativeHeading level="h1" class="page-title" text="Legal notice" /></div></section>
  <section class="section"><div class="container--small prose">
    <h2>Information pursuant to Section 5 DDG</h2>
    <address class="legal-address">
      <strong>Daniela Schneider</strong><br />
      Netzestr. 12<br />
      12051 Berlin<br />
      Germany
    </address>

    <h2>Contact</h2>
    {settings.email && <p>Email: <a href={`mailto:${settings.email}`}>{settings.email}</a></p>}

    <h2>Activity</h2>
    <p>Handpan music, handpan lessons, workshops and musical accompaniment for events.</p>

    <h2>Responsible for the content</h2>
    <address class="legal-address">
      Daniela Schneider<br />
      Netzestr. 12<br />
      12051 Berlin
    </address>

    <h2>Liability for content</h2>
    <p>The content of this website has been prepared with care. Nevertheless, no guarantee can be given that the content is accurate, complete or up to date. Statutory obligations to remove or block information remain unaffected.</p>

    <h2>Liability for links</h2>
    <p>This website may contain links to external third-party websites. We have no influence over their content. The respective provider or operator is always responsible for the content of linked pages. No unlawful content was apparent at the time the links were created. Links will be removed if a legal infringement becomes known.</p>

    <h2>Copyright</h2>
    <p>The content, photographs and designs published on this website are protected by copyright. Any use beyond the limits permitted by law requires the prior consent of the respective rights holder.</p>
  </div></section>
</BaseLayout>

<style>.legal-address { font-style: normal; }</style>
