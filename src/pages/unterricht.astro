---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CoachingHero from '../components/CoachingHero.astro';
import Button from '../components/Button.astro';
import '../styles/coaching.css';
import learningImage from '../assets/images/originals/sample-learning-guidance.png';
import { copyList, copyParagraphs, getPageCopy, getService, imageUrl, localizeService } from '../lib/sanity';
import { defaultsFor } from '../content/page-copy-defaults';
import { localizePath, type Language } from '../lib/i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const service = localizeService(await getService('Unterricht'), lang);
const copy = await getPageCopy('unterricht', lang, defaultsFor('unterricht', lang));
const image = imageUrl(service.image, 1200);
---

<BaseLayout image={image} lang={lang}>
  <div class="coaching-page">
  <CoachingHero lang={lang} title={copy.title} intro={copy.intro} />

  <section class="section" id="einzelbegleitung">
    <div class="container rich-layout">
      <aside>
        {image ? (
          <div class="feature-image"><img src={image} alt={service.image?.alt || copy.imageAlt} width="1200" /></div>
        ) : (
          <div class="feature-image"><Image src={learningImage} alt={copy.imageAlt} width={1200} /></div>
        )}
        {(service.duration || service.priceInfo) && (
          <div class="meta-row">
            {service.duration && <span class="meta-chip">{copy.durationLabel}: {service.duration}</span>}
            {service.priceInfo && <span class="meta-chip">{service.priceInfo}</span>}
          </div>
        )}
      </aside>

      <div>
        <div class="prose">
          {copyParagraphs(copy.body).map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <ul class="topic-list">
          {copyList(copy.topics).map((topic) => <li>{topic}</li>)}
        </ul>
        <div class="action"><Button href={localizePath('/kontakt?interesse=unterricht', lang)}>{copy.cta}</Button></div>
        <p class="level-link">{copy.levelPrompt} <a href={localizePath('/selbsteinschaetzung', lang)}>{copy.levelLink}</a></p>
      </div>
    </div>
  </section>

  </div>
</BaseLayout>

<style>
  .topic-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-sand);
    list-style: none;
  }

  .topic-list li {
    position: relative;
    padding: 0.85rem 0.5rem 0.85rem 1.4rem;
    border-bottom: 1px solid var(--color-sand);
    color: var(--color-ink);
  }

  .topic-list li::before {
    content: '↗';
    position: absolute;
    left: 0;
    color: var(--color-clay);
  }

  .prose { margin-top: 1rem; }
  .action { margin-top: 2rem; }
  .level-link { margin-top: 1.25rem; color: var(--color-steel); font-size: 0.92rem; }
  .level-link a { color: var(--color-clay-dark); font-weight: 700; }


  @media (max-width: 38rem) { .topic-list { grid-template-columns: 1fr; } }
</style>
