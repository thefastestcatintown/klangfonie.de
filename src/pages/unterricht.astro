---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CoachingHero from '../components/CoachingHero.astro';
import Button from '../components/Button.astro';
import DecorativeHeading from '../components/DecorativeHeading.astro';
import '../styles/coaching.css';
import learningImage from '../assets/images/sample-learning-guidance.png';
import { getService, imageUrl } from '../lib/sanity';
import { localizePath, type Language } from '../lib/i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const english = lang === 'en';
const service = await getService('Unterricht');
const image = imageUrl(service.image, 1200);
---

<BaseLayout image={image} lang={lang}>
  <div class="coaching-page">
  <CoachingHero lang={lang} title={english ? 'One-to-one handpan guidance' : 'Lernbegleitung 1:1'} intro={english ? 'Learn the handpan at your own pace, with space for the ideas and wishes that suit you. Personal guidance for beginners and advanced players.' : 'Handpan lernen – in deinem Tempo und mit Raum für Ideen und Wünsche, die dir entsprechen. Persönliche Lernbegleitung für Anfänger und Fortgeschrittene.'} />

  <section class="section" id="einzelbegleitung">
    <div class="container rich-layout">
      <aside>
        {image ? (
          <div class="feature-image"><img src={image} alt={english ? 'Personal handpan guidance with Daniela Schneider' : (service.image?.alt || service.title)} width="1200" /></div>
        ) : (
          <div class="feature-image"><Image src={learningImage} alt={english ? 'Personal guidance on a copper-coloured handpan' : 'Persönliche Lernbegleitung an einer kupferfarbenen Handpan'} width={1200} /></div>
        )}
        {(service.duration || service.priceInfo) && (
          <div class="meta-row">
            {service.duration && <span class="meta-chip">{english ? 'Duration' : 'Dauer'}: {service.duration}</span>}
            {service.priceInfo && <span class="meta-chip">{service.priceInfo}</span>}
          </div>
        )}
      </aside>

      <div>
        <DecorativeHeading level="h2" text={english ? 'What you will learn in handpan lessons' : 'Was du beim Handpan-Unterricht lernst'} />
        <div class="prose">
          <p>{english ? 'Perhaps you already have musical experience and would like feedback and fresh inspiration. Perhaps you have never played an instrument. Or perhaps your first handpan is already at home and you are wondering: what now?' : 'Vielleicht bringst du bereits musikalische Vorerfahrung mit und wünschst dir Feedback und neue Inspirationen. Vielleicht hast du noch nie ein Instrument gespielt. Vielleicht steht deine erste Handpan bereits zuhause und du fragst dich: Und jetzt?'}</p>
          <p>{english ? 'In one-to-one guidance, we combine a clear structure with curious exploration. The aim is not to learn as much as possible as quickly as possible, but to build a confident and musical approach.' : 'In der Lernbegleitung 1:1 verbinden wir eine verständliche Struktur mit neugierigem Ausprobieren. Es geht nicht darum, möglichst schnell möglichst viel zu können, sondern einen sicheren, musikalischen Zugang aufzubauen.'}</p>
        </div>
        <ul class="topic-list">
          {(english ? ['Rhythm and timing', 'Touch and tone', 'Grooves and patterns', 'Melody and dynamics', 'Coordination', 'Transitions and variations', 'Free playing and improvisation', 'Composition and arrangement'] : ['Rhythmus und Timing', 'Anschlagtechnik und Klang', 'Grooves und Patterns', 'Melodie und Dynamik', 'Koordination', 'Übergänge und Variationen', 'Freies Spiel und Improvisation', 'Komposition und Arrangement']).map((topic) => <li>{topic}</li>)}
        </ul>
        <div class="action"><Button href={localizePath('/kontakt?interesse=unterricht', lang)}>{english ? 'Enquire about guidance' : 'Lernbegleitung anfragen'}</Button></div>
      </div>
    </div>
  </section>

  </div>
</BaseLayout>

<style>
  .topic-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-sand);
    list-style: none;
  }

  .topic-list li {
    position: relative;
    padding: 0.85rem 0.5rem 0.85rem 1.4rem;
    border-bottom: 1px solid var(--color-sand);
    color: var(--color-ink);
  }

  .topic-list li::before {
    content: '↗';
    position: absolute;
    left: 0;
    color: var(--color-clay);
  }

  .prose { margin-top: 1rem; }
  .action { margin-top: 2rem; }


  @media (max-width: 38rem) { .topic-list { grid-template-columns: 1fr; } }
</style>
