---
import BaseLayout from '../layouts/BaseLayout.astro';
import DecorativeHeading from '../components/DecorativeHeading.astro';
import { getSettings } from '../lib/sanity';
import type { Language } from '../lib/i18n';
interface Props { lang?: Language; }
const { lang = 'de' } = Astro.props;
const english = lang === 'en';
const settings = await getSettings();
const formEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT?.trim();
const formCopy = english ? {
  defaultInterest: 'Enquiry', greeting: 'Hello Daniela,', signoff: 'Best wishes', sending: 'Sending…', submit: 'Send message',
  success: 'Thank you! Your message has been sent. I will get back to you personally.',
  error: 'Your message could not be sent right now. Please try again or use the email address provided.',
  prepared: 'The message has been prepared in your email programme. Please review it there and send it.',
  copied: 'The enquiry has been copied. You can now paste it into an email or message.',
} : {
  defaultInterest: 'Anfrage', greeting: 'Hallo Daniela,', signoff: 'Viele Grüße', sending: 'Wird gesendet…', submit: 'Nachricht senden',
  success: 'Vielen Dank! Deine Nachricht wurde gesendet. Ich melde mich persönlich bei dir zurück.',
  error: 'Die Nachricht konnte gerade nicht gesendet werden. Bitte versuche es noch einmal oder nutze die angegebene E-Mail-Adresse.',
  prepared: 'Die Nachricht wurde in deinem E-Mail-Programm vorbereitet. Bitte prüfe sie dort und sende sie ab.',
  copied: 'Die Anfrage wurde kopiert. Du kannst sie nun in eine E-Mail oder Nachricht einfügen.',
};
---
<BaseLayout lang={lang}>
  <section class="page-hero"><div class="container page-hero__inner"><DecorativeHeading level="h1" class="page-title" text={english ? 'Enquire about handpan in Berlin' : 'Handpan in Berlin anfragen'} /><p class="lead">{english ? 'Whether you are interested in handpan lessons, a workshop or live music, a few lines are enough to begin. I will get back to you personally.' : 'Ob Handpan-Unterricht, Workshop oder Live-Musik: Ein paar Zeilen genügen für den Anfang. Ich melde mich persönlich bei dir zurück.'}</p></div></section>
  <section class="section"><div class="container contact-grid">
    <aside>
      <DecorativeHeading level="h2" text={settings.email ? (english ? 'Prefer email?' : 'Lieber per E-Mail?') : (english ? 'Your enquiry' : 'Deine Anfrage')} />
      {settings.email
        ? <a class="email" href={`mailto:${settings.email}`}>{settings.email}</a>
        : <p class="intro">{english ? 'Tell me briefly how I can support you. You can then copy your enquiry with one click.' : 'Erzähl mir kurz, wobei ich dich begleiten darf. Deine Anfrage kannst du anschließend mit einem Klick kopieren.'}</p>}
      {settings.phone && <a class="contact-line" href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a>}
      {settings.email && <p class="note">{english ? 'You can use the form or email Daniela directly.' : 'Du kannst das Formular nutzen oder Daniela direkt eine E-Mail schreiben.'}</p>}
    </aside>
    <form class="contact-form" data-contact-form data-endpoint={formEndpoint || undefined} data-recipient={settings.email || undefined} data-copy={JSON.stringify(formCopy)} novalidate>
      <div class="field-row">
        <label><span>Name</span><input type="text" name="name" autocomplete="name" required /></label>
        <label><span>{english ? 'Email' : 'E-Mail'}</span><input type="email" name="email" autocomplete="email" required /></label>
      </div>
      <label><span>{english ? 'What are you interested in?' : 'Wofür interessierst du dich?'}</span>
        <select name="interest" required data-interest>
          <option value="">{english ? 'Please select' : 'Bitte auswählen'}</option><option value="unterricht">{english ? 'One-to-one guidance' : 'Lernbegleitung 1:1'}</option><option value="ensemble">Big Band</option><option value="workshops">Handpan Workshops</option><option value="yoga">{english ? 'Retreat music' : 'Yoga-Begleitung'}</option><option value="live">{english ? 'Live music' : 'Live-Musik'}</option><option value="band">{english ? 'Band / concert' : 'Band / Konzert'}</option><option value="sonstiges">{english ? 'Other' : 'Sonstiges'}</option>
        </select>
      </label>
      <label><span>{english ? 'Message' : 'Nachricht'}</span><textarea name="message" rows="7" required placeholder={english ? 'What would you like to ask about?' : 'Was möchtest du gerne anfragen?'}></textarea></label>
      <label class="honeypot" aria-hidden="true">{english ? 'Please leave blank' : 'Bitte nicht ausfüllen'}<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      <button type="submit"><span data-submit-label>{formEndpoint ? (english ? 'Send message' : 'Nachricht senden') : settings.email ? (english ? 'Prepare email' : 'E-Mail vorbereiten') : (english ? 'Copy enquiry' : 'Anfrage kopieren')}</span> <span aria-hidden="true">↗</span></button>
      <p class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status hidden></p>
    </form>
  </div></section>
</BaseLayout>
<script>
  const select = document.querySelector<HTMLSelectElement>('[data-interest]');
  const interest = new URLSearchParams(window.location.search).get('interesse');
  if (select && interest && [...select.options].some((option) => option.value === interest)) select.value = interest;
  document.querySelector<HTMLFormElement>('[data-contact-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    if (!form.reportValidity()) return;
    const endpoint = form.dataset.endpoint;
    const recipient = form.dataset.recipient;
    const copy = JSON.parse(form.dataset.copy || '{}');
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const selectedInterest = form.querySelector<HTMLSelectElement>('[name="interest"]')?.selectedOptions[0]?.textContent?.trim() || copy.defaultInterest || 'Anfrage';
    const message = String(data.get('message') || '').trim();
    const subject = `Klangfonia – ${selectedInterest}`;
    const body = `${copy.greeting || 'Hallo Daniela,'}\n\n${message}\n\n${copy.signoff || 'Viele Grüße'}\n${name}\n${email}`;
    const status = document.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');

    if (endpoint && button && submitLabel) {
      button.disabled = true;
      submitLabel.textContent = copy.sending || 'Wird gesendet…';
      if (status) status.hidden = true;

      data.set('_subject', subject);
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`Formularversand fehlgeschlagen (${response.status})`);

        form.reset();
        if (select && interest && [...select.options].some((option) => option.value === interest)) select.value = interest;
        if (status) {
          status.textContent = copy.success;
          status.dataset.state = 'success';
        }
      } catch {
        if (status) {
          status.textContent = copy.error;
          status.dataset.state = 'error';
        }
      } finally {
        button.disabled = false;
        submitLabel.textContent = copy.submit || 'Nachricht senden';
        if (status) { status.hidden = false; status.focus(); }
      }
      return;
    }

    if (recipient) {
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (status) status.textContent = copy.prepared;
    } else {
      await navigator.clipboard.writeText(`${subject}\n\n${body}`);
      if (status) status.textContent = copy.copied;
    }
    if (status) { status.hidden = false; status.focus(); }
  });
</script>
<style>
  .contact-grid { display: grid; gap: var(--layout-gap); align-items: start; }
  aside { position: sticky; top: 9rem; } aside :global(h2) { max-width: 15ch; font-size: clamp(2rem, 3vw, 2.75rem); }
  .email { display: inline-block; margin-top: 1.5rem; color: var(--color-clay); font-weight: 700; }.contact-line { display: block; margin-top: 0.65rem; color: var(--color-steel); }
  .intro { max-width: 28rem; margin-top: 1.5rem; color: var(--color-steel); }
  .note { max-width: 30rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-sand); color: var(--color-steel); font-size: 0.9rem; }
  .contact-form { display: grid; gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-linen); box-shadow: var(--shadow-soft); }
  .field-row { display: grid; gap: 1rem; }
  label { display: grid; gap: 0.45rem; color: var(--color-ink); font-size: 0.83rem; font-weight: 700; }
  input, select, textarea { width: 100%; border: 1px solid rgb(36 55 70 / 0.22); border-radius: var(--radius-sm); background: var(--color-white); color: var(--color-charcoal); }
  input, select { min-height: 3.25rem; padding: 0 0.9rem; } textarea { min-height: 10rem; padding: 0.8rem 0.9rem; resize: vertical; }
  input:focus, select:focus, textarea:focus { border-color: var(--color-clay); outline: 2px solid rgb(184 121 85 / 0.18); }
  button { display: inline-flex; width: fit-content; min-height: 3.25rem; align-items: center; gap: 0.75rem; padding: 0.75rem 1.25rem; border: 0; border-radius: 99rem; background: var(--color-clay); color: white; font-size: 0.86rem; font-weight: 720; cursor: pointer; transition: background 180ms ease, transform 180ms ease; }
  button:hover { background: var(--color-clay-dark); transform: translateY(-2px); }
  button:disabled { cursor: wait; opacity: 0.7; transform: none; }
  .email { max-width: 100%; overflow-wrap: anywhere; }
  .contact-grid > * { min-width: 0; }
  .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .form-status { padding: 1rem; border-left: 3px solid var(--color-clay); background: var(--color-white); color: var(--color-steel); }.form-status[data-state='success'] { border-left-color: var(--color-ink); }.form-status[data-state='error'] { border-left-color: #a23b2a; color: #7d2e21; }.form-status a { color: var(--color-ink); font-weight: 700; }
  @media (min-width: 42rem) { .field-row { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 52rem) { .contact-grid { grid-template-columns: 0.75fr 1.25fr; } }
  @media (max-width: 51.99rem) { aside { position: static; } }
  @media (min-width: 60rem) and (max-height: 56rem) {
    .contact-form { gap: 1rem; padding: 1.5rem; }
    textarea { min-height: 7rem; }
    .note { margin-top: 2rem; }
  }
</style>
