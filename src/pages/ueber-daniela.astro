---
import { Image, getImage } from 'astro:assets';
import profil2 from '../assets/images/profil2.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import RichText from '../components/RichText.astro';
import Button from '../components/Button.astro';
import { getAbout } from '../lib/sanity';
const about = await getAbout();
const portrait = await getImage({ src: profil2, width: 1200, format: 'webp' });
const hasCmsBody = Boolean(about.body?.length);
const intention = [
  'Ich möchte Menschen durch Musik berühren, Emotionen wecken und besondere Momente schaffen, die in Erinnerung bleiben. Für mich ist Handpan-Musik mehr als Klang – sie ist Energie, Ausdruck und eine Sprache, die Menschen verbindet.',
  'Als Percussionistin und Handpan-Musikerin verbinde ich Rhythmus, Feingefühl und Leidenschaft zu atmosphärischen und melodiösen Klangerlebnissen – mal sanft und tief, mal kraftvoll und lebendig. Dabei folge ich dem Gespür für den Augenblick und der Magie, die entsteht, wenn klangvolle Melodien Menschen im Innersten erreichen.',
  'Musik ist meine Sprache. Rhythmus ist meine Leidenschaft. Verbindung ist meine Intention.',
];
const story = [
  'Die Freude am gemeinsamen Musizieren begleitet mich seit meiner Kindheit. Mein musikalischer Weg führte mich über das Studium des klassischen Schlagwerks und der Elementaren Musikpädagogik an der Hochschule für Musik in Nürnberg auf deutschlandweite Bühnen mit unterschiedlichen Bandprojekten – von Jazz, Rock und Pop bis hin zur akustischen Salonmusik.',
  'Aus jahrzehntelanger musikalischer Erfahrung schöpfe ich heute die Vielfalt und Ausdruckskraft meiner Handpan-Musik.',
];
---
<BaseLayout image={portrait.src}>
  <section class="page-hero"><div class="container page-hero__inner"><h1>{about.headline}</h1>{about.intro && <p class="lead">{about.intro}</p>}</div></section>
  <div class="container location-note"><p>Danielas Handpan-Angebote sind in Berlin-Neukölln zuhause.</p></div>
  <section class="section"><div class="container rich-layout">
    <div class="portrait"><Image src={profil2} alt="Daniela Schneider spielt Handpan unter einem Baum" widths={[480, 800, 1200, 1662]} sizes="(min-width: 84rem) 505px, (min-width: 48rem) 42vw, calc(100vw - 2rem)" /></div>
    <div>
      {hasCmsBody ? <RichText value={about.body} /> : <>
        <div class="about-section" id="intention">
          <h2>Meine Intention</h2>
          <div class="prose">{intention.map((paragraph) => <p>{paragraph}</p>)}</div>
        </div>
        <div class="about-section" id="geschichte">
          <h2>Meine Geschichte</h2>
          <div class="prose">{story.map((paragraph) => <p>{paragraph}</p>)}</div>
        </div>
      </>}
      {about.milestones && about.milestones.length > 0 && <div class="milestones">{about.milestones.map((item) => <div class="milestone">
        <span>{item.year}</span>
        <div class="milestone__content">
          <p><strong>{item.text}</strong></p>
          {item.details && item.details.length > 0 && <ul>{item.details.map((detail) => {
            const [name, description] = detail.split(' – ');
            return <li>{description ? <><strong>{name}</strong> – {description}</> : detail}</li>;
          })}</ul>}
        </div>
      </div>)}</div>}
      <div class="about-links"><Button href="/unterricht">Lernbegleitung entdecken</Button><Button href="/kontakt" variant="secondary">Daniela kontaktieren</Button></div>
    </div>
  </div></section>
</BaseLayout>
<style>
  .portrait { position: sticky; top: 9rem; overflow: hidden; aspect-ratio: 3 / 4; padding: 0; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-sage-soft); }
  .location-note { margin-top: 1.25rem; color: var(--color-steel); font-size: 0.95rem; }
  .about-section + .about-section { margin-top: 3.5rem; }
  .about-section h2 + .prose { margin-top: 1rem; }
  .prose { display: grid; gap: 1rem; color: var(--color-steel); }
  .about-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .portrait :global(img) { width: 100%; height: 100%; border-radius: var(--radius-lg); object-fit: cover; object-position: 28% center; box-shadow: var(--shadow-soft); }
  .milestones { margin-top: 3rem; }
  .milestone { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--color-sand); }
  .milestone > span { color: var(--color-clay); font-weight: 700; }
  .milestone__content { color: var(--color-steel); }
  .milestone__content ul { display: grid; gap: 0.35rem; margin: 0.75rem 0 0; padding-left: 1.25rem; }
  @media (max-width: 47.99rem) {
    .portrait { position: static; }
    .milestone { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
