---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VideoSection from '../components/VideoSection.astro';
import EventsSection from '../components/EventsSection.astro';
import { getFeaturedVideo, getHome } from '../lib/sanity';

const [home, video] = await Promise.all([getHome(), getFeaturedVideo()]);
const intro = {
  ...home,
  heroText: 'Handpan entdecken, gemeinsam wachsen und Musik erleben. Mit Daniela Schneider.',
  primaryCtaLabel: 'Lernbegleitung entdecken',
  primaryCtaUrl: '/unterricht',
  secondaryCtaLabel: 'Musik hören',
  secondaryCtaUrl: '#musik',
};
---
<BaseLayout>
  <div class="home-content">
    <Hero content={intro} />
    <VideoSection video={video} headline="Ein Moment Musik." text="Lehn dich zurück und hör rein." />
    <EventsSection />
  </div>
</BaseLayout>

<style>
  .home-content { --section-space: clamp(2.5rem, 4vw, 3.5rem); }
</style>
