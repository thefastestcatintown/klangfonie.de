---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VideoSection from '../components/VideoSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import AboutPreview from '../components/AboutPreview.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Button from '../components/Button.astro';
import { getFeaturedVideo, getHome, getServices, getTestimonials } from '../lib/sanity';

const [home, services, testimonials, video] = await Promise.all([
  getHome(), getServices(), getTestimonials(), getFeaturedVideo(),
]);
---
<BaseLayout>
  <Hero content={home} />

  <section class="section services-section">
    <div class="container">
      <SectionHeading eyebrow="DEIN EINSTIEG" title="Wohin zieht es dich?" text="Wähle den Weg, der gerade zu dir passt – selbst spielen, eine Yogaklasse begleiten lassen oder Live-Musik erleben." />
      <div class="services-grid">{services.slice(0, 3).map((service, index) => <ServiceCard service={service} index={index} />)}</div>
    </div>
  </section>

  <VideoSection video={video} headline={home.introHeadline} text={home.introText} />

  <AboutPreview />

  <section class="section section--linen lesson-section">
    <div class="container lesson-grid">
      <div>
        <p class="eyebrow">LERNBEGLEITUNG</p>
        <h2>Handpan spielen lernen</h2>
        <p class="lesson-subline">Ohne Leistungsdruck. Mit Struktur.</p>
      </div>
      <div>
        <p class="lead">Vielleicht hast du noch nie ein Instrument gespielt. Vielleicht steht deine erste Handpan bereits zuhause und du fragst dich: Und jetzt?</p>
        <ul class="simple-list">
          <li>Rhythmus und Timing</li><li>Anschlagtechnik und Klang</li><li>Grooves und Patterns</li><li>Melodie und Dynamik</li><li>Koordination</li><li>Übergänge und Variationen</li><li>Freies Spiel und Improvisation</li>
        </ul>
        <p class="highlight">Du musst keine musikalische Vorerfahrung mitbringen.</p>
        <div class="lesson-action"><Button href="/kontakt?interesse=unterricht">Lernbegleitung anfragen</Button></div>
      </div>
    </div>
  </section>

  <section class="section philosophy">
    <div class="container">
      <SectionHeading eyebrow="DER WEG" title="Hören. Spielen. Loslassen." />
      <div class="philosophy-grid">
        <article><span>01</span><h3>Hören</h3><p>Bevor Musik entsteht, entsteht Aufmerksamkeit.</p></article>
        <article><span>02</span><h3>Spielen</h3><p>Rhythmus darf ausprobiert werden. Fehler gehören dazu.</p></article>
        <article><span>03</span><h3>Loslassen</h3><p>Irgendwann hört man auf nachzudenken – und beginnt Musik zu machen.</p></article>
      </div>
    </div>
  </section>

  <section class="section yoga-teaser">
    <div class="container yoga-inner">
      <div><p class="eyebrow">YOGA & HANDPAN</p><h2>Wenn Bewegung zu Klang wird.</h2></div>
      <div>
        <p class="lead">Live-Musik verändert eine Yogaklasse nicht, weil sie spektakulärer wird, sondern weil Klang Bewegungen verbinden, Übergänge tragen und Stille vertiefen kann.</p>
        <div class="yoga-tags"><span>Vinyasa</span><span>Yin Yoga</span><span>Meditation & Savasana</span><span>Retreats & Specials</span></div>
        <Button href="/kontakt?interesse=yoga" variant="secondary">Gemeinsame Klasse anfragen</Button>
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section reviews-section" aria-labelledby="reviews-heading">
      <div class="container reviews-layout">
        <div class="reviews-intro">
          <p class="eyebrow">ERFAHRUNGEN</p>
          <h2 id="reviews-heading">Was andere über Klangfonia sagen</h2>
          <p class="lead">Persönliche Erfahrungen aus der Lernbegleitung, beim Yoga und bei gemeinsamen Veranstaltungen.</p>
        </div>
        <div class:list={['testimonials-grid', { 'testimonials-grid--single': testimonials.length === 1 }]}>
          {testimonials.slice(0, 4).map((item) => <TestimonialCard testimonial={item} />)}
        </div>
      </div>
    </section>
  )}
  <ContactCTA />
</BaseLayout>

<style>
  .services-section { border-bottom: 1px solid rgb(38 53 47 / 0.08); background: var(--color-white); }
  .services-grid { display: grid; gap: 1rem; margin-top: 3.5rem; }
  .lesson-grid, .yoga-inner { display: grid; gap: clamp(2.5rem, 8vw, 7rem); align-items: start; }
  .lesson-subline { margin-top: 1.1rem; color: var(--color-clay); font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2rem); }
  .lesson-action { margin-top: 2rem; }
  .philosophy-grid { display: grid; gap: 1rem; margin-top: 3.5rem; }
  .philosophy { background: var(--color-linen); }
  .philosophy article { padding: 2rem; border: 1px solid rgb(38 53 47 / 0.1); border-radius: 1.5rem; background: rgb(255 253 247 / 0.45); }
  .philosophy article > span { display: block; margin-bottom: 3rem; color: var(--color-clay); font-size: 0.76rem; font-weight: 740; letter-spacing: 0.1em; }
  .philosophy article p { max-width: 19rem; margin-top: 1rem; color: var(--color-steel); }
  .yoga-teaser { background: radial-gradient(circle at 15% 30%, rgb(255 253 247 / 0.75), transparent 18rem), linear-gradient(120deg, var(--color-sage-soft) 0%, var(--color-linen) 68%); }
  .yoga-tags { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 2rem 0; }
  .yoga-tags span { padding: 0.45rem 0.85rem; border: 1px solid rgb(36 55 70 / 0.2); border-radius: 99rem; color: var(--color-ink); font-size: 0.82rem; }
  .reviews-section { background: radial-gradient(circle at 8% 85%, rgb(165 93 58 / 0.1), transparent 22rem), var(--color-linen); }
  .reviews-layout { display: grid; gap: clamp(2.5rem, 7vw, 6rem); align-items: start; }
  .reviews-intro { max-width: 34rem; }
  .reviews-intro .lead { max-width: 29rem; margin-top: 1.5rem; }
  .testimonials-grid { display: grid; gap: 1rem; }
  @media (min-width: 43rem) { .services-grid, .philosophy-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 50rem) { .lesson-grid, .yoga-inner { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); } }
  @media (min-width: 60rem) {
    .reviews-layout { grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr); }
    .testimonials-grid:not(.testimonials-grid--single) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
