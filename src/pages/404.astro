---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import DecorativeHeading from '../components/DecorativeHeading.astro';
---
<BaseLayout title="Seite nicht gefunden – Klangfonia" description="Die angefragte Seite wurde nicht gefunden." noindex>
  <section class="page-hero"><div class="container page-hero__inner"><DecorativeHeading level="h1" text="Dieser Klang ist verklungen." /><p class="lead">Die gesuchte Seite gibt es nicht oder nicht mehr.</p><div class="action"><Button href="/">Zur Startseite</Button></div></div></section>
</BaseLayout>
<style>.action { margin-top: 2rem; }</style>
