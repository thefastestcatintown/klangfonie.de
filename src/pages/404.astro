---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Seite nicht gefunden – Klangfonie" description="Die angefragte Seite wurde nicht gefunden." noindex>
  <section class="page-hero"><div class="container page-hero__inner"><p class="eyebrow">404</p><h1>Dieser Klang ist verklungen.</h1><p class="lead">Die gesuchte Seite gibt es nicht oder nicht mehr.</p><div class="action"><Button href="/">Zur Startseite</Button></div></div></section>
</BaseLayout>
<style>.action { margin-top: 2rem; }</style>
