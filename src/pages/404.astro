---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import DecorativeHeading from '../components/DecorativeHeading.astro';
import { getPageCopy } from '../lib/sanity';
import { defaultsFor } from '../content/page-copy-defaults';
const copy = await getPageCopy('global', 'de', defaultsFor('global', 'de'));
---
<BaseLayout title="Seite nicht gefunden – Klangfonia" description="Die angefragte Seite wurde nicht gefunden." noindex>
  <section class="page-hero"><div class="container page-hero__inner"><DecorativeHeading level="h1" class="page-title" text={copy.notFoundTitle} /><p class="lead">{copy.notFoundText}</p><div class="action"><Button href="/">{copy.notFoundCta}</Button></div></div></section>
</BaseLayout>
<style>.action { margin-top: 2rem; }</style>
